! The language of lexicon.lexc's entries, which scripts/gen/lexicon.py writes:
! a pronunciation aligned to its spelling, one segment per consonant cluster
! and per vowel. report is `R=r IY0=e P=p AO1=o R.T=rt`.
!
! A stage that reads the lexicon's entries, or writes more of them, names its
! pieces with these.

define Gap      " " ;
define Eq       "=" ;
define Dot      "." ;

define VowelLetter [ a | e | i | o | u | y ] ;
define Letter   [ a | b | c | d | e | f | g | h | i | j | k | l | m
                | n | o | p | q | r | s | t | u | v | w | x | y | z ] ;
define Cons     [ B | CH | D | DH | F | G | HH | JH | K | L | M | N | NG
                | P | R | S | SH | T | TH | V | W | Y | Z | ZH ] ;
define Unstressed [ AA0 | AE0 | AH0 | AO0 | AW0 | AY0 | EH0 | ER0 | EY0
                  | IH0 | IY0 | OW0 | OY0 | UH0 | UW0 ] ;
define Stressed [ AA1 | AE1 | AH1 | AO1 | AW1 | AY1 | EH1 | ER1 | EY1
                | IH1 | IY1 | OW1 | OY1 | UH1 | UW1 ] ;
define Secondary [ AA2 | AE2 | AH2 | AO2 | AW2 | AY2 | EH2 | ER2 | EY2
                 | IH2 | IY2 | OW2 | OY2 | UH2 | UW2 ] ;
define Vowel    [ Unstressed | Stressed | Secondary ] ;
define RVowel   [ ER0 | ER1 | ER2 ] ;

! A consonant cluster's phonemes: `More` has at least one.
define More     [ Cons [ Dot Cons ]* ] ;
define Phones   [ ( More ) ] ;
! Letters after a segment's that spell nothing: a final e or ue, aye's e.
define Tail     [ "_" Letter+ ] ;

define ConsSeg  [ Phones Eq Letter* ] ;
define VowelSeg [ Vowel Eq Letter+ ( Tail ) ] ;
define LastSeg  [ Phones Eq Letter* ( Tail ) ] ;

! The pronunciation's place in CMU's order, then a `'` for each rewrite the
! word has another outline without: the resolver takes the outline only where
! those are taken.
define Cost     "'" ;

! What the rewrites did, after the costs: `!` for each syllable one dropped,
! `&` for an affix whose keys took a syllable's place. `@` is the lexicon's,
! on a pronunciation of a word it also has an outline for, which split.xfst
! takes only where a rewrite made it shorter.
define Dropped  "!" ;
define Affixed  "&" ;
define Outlines "@" ;
define Flag     [ Dropped | Affixed | Outlines ] ;
define Rank     [ [ 1 | 2 | 3 | 4 ] Cost* Flag* ] ;

define Word     [ ConsSeg [ Gap VowelSeg Gap ConsSeg ]* Gap VowelSeg Gap LastSeg ] ;
define Entry    [ Rank Gap Word ] ;

! Two words, which pairs.lexc writes: go home is `1 G=g OW0=o = + HH=h OW1=o M=m_e`.
define Plus     [ Gap "+" Gap ] ;
define PairEntry [ Rank Gap Word Plus Word ] ;

! The written-out form: an entry as written.xfst writes it, which the rewrites
! before the contraction read and write. Each vowel is its syllable's chord as
! the vowel table writes it, after its stress (0, 1, or 2 for secondary), r if
! it is r-coloured, and its letters. The consonants stay as the entry has them
! until the contraction puts them on a bank.
!
!     report  1 R=r 0:e=E P=p 1:o=O R.T=rt
!     river   1 R=r 1:i=EU V=v 0r:e=E R=r
!
! A rewrite that drops a syllable writes before the onset what stands for it: a
! prefix's cluster, or `^`. One that writes a suffix as its keys puts them after
! the coda, with a `-`.
define Level    [ "0" | "1" | "2" ] ;
define Chorded  [ Level ( r ) ":" Letter+ Eq VowelKeys ] ;
define Lead     [ "^" | LeftKey+ ] ;
define Suffix   [ "-" RightKey+ ] ;
define WrittenWord [ ConsSeg [ Gap Chorded Gap ConsSeg ]* Gap Chorded Gap LastSeg ] ;
define Written  [ Rank Gap ( Lead Gap ) WrittenWord ( Gap Suffix ) ] ;
define WrittenPair [ Rank Gap WrittenWord Plus WrittenWord ] ;

! Strokes: split.xfst's syllables as theory.xfst writes them, or a word's
! outline from the lexicon, which is strokes already. Each stroke's chord has
! its head before it: `1:` where it has the stress, else `0`, the keys its
! operand gives, and `:`. contract.xfst contracts two strokes into one.
!
!     report     1 R0E:E/P1:Ort
!     pirouette  1 P0EU:EUr/W1:Et
define Head     [ "1" ":" | "0" (A) (O) (E) (U) ":" ] ;
define KeyStroke [ LeftKey* Head VowelKeys RightKey* ] ;
define Strokes  [ Rank Gap ( Lead Gap ) KeyStroke ( "/" KeyStroke ) ] ;

! An outline in lexicon.lexc: two strokes, the stressed one's head `1:` and
! the other's `0:`.
define Outlined [ Rank Gap LeftKey* [ "0" | "1" ] ":" VowelKeys RightKey* "/" LeftKey* [ "0" | "1" ] ":" VowelKeys RightKey* ] ;

! A rewrite R, defined only where it applies, and the word as it was:
! `Instead` takes the rewrite only, `Before` puts the word as it was one
! rewrite later, and `After` puts the rewrite later.
define Later    [ [ 1 | 2 | 3 | 4 ] Cost* Ins(Cost) ?* ] ;
define Flagged(F) [ [ 1 | 2 | 3 | 4 ] Cost* Flag* Ins(F) Gap ?* ] ;
define Instead(R) PU(R, ?*) ;
define Before(R) [ R | [ R.u .o. Later ] | ~R.u ] ;
define After(R) [ [ R .o. Later ] | ?* ] ;
