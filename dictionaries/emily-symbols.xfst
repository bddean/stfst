! Emily's symbol dictionary, mirrored to the left hand.
!
! Six independent fields. Repeat counts on -F and -P and attachment sets on -R
! and -B, so those two interleave on the board:
!
!   STKPWHR   AO        f       r          p       b          g     tz
!   pattern   variant   rep +1  attach-l   rep +2  attach-r   cap   id
!
! The table is `emily-symbols-tables.xfst`, which `emily-modifiers` shares.
! Everything here is a rule, so adding a row to it gives all of that row's
! variant, attach, capitalisation and repeat combinations at once. The Python this
! replaces enumerated 5,248 strokes to say the same thing, and raised KeyError
! seven times where here a path simply does not exist.
!
! Note what validates the pattern: nothing does, explicitly. `Pat` accepts any
! subset of STKPWHR, and a subset with no row dies at the Glyph composition. So
! the table is the only place the 37 patterns are written down.
!
! This fork sets attachmentMethod = "space", which inverts the two keys: the
! symbol attaches on both sides by default, and -R and -B open a space instead.
! What is not copied is how that file writes it, which is literal spaces around
! the glyph. The flags say the joins and the host spaces the symbol, which also
! makes repetition well defined: [REP3] over " ! " gives " ! ! ! ".

! ---- fields, in steno order

! Any left-bank subset. Which subsets are real is the table's business.
define Pat      [ (S) (T) (K) (P) (W) (H) (R) ] ;
define Variant  [ 0    .x. V0 ] | [ {A}  .x. V1 ]
              | [ {O}  .x. V2 ] | [ {AO} .x. V3 ] ;
! -R and -B are independent, so they are two bits and not a four-way table.
define AttachL  Bit({r}, "[AL=1]", "[AL=0]") ;
define AttachR  Bit({b}, "[AR=1]", "[AR=0]") ;
define Cap      Bit({g}, "[C=0]", "[C=1]") ;
! The count is a sum, and attachment splits the two bits, so `DoRep` adds them
! where the tags fall rather than reading one field.
define Rep1     Bit({f}, "[R1=0]", "[R1=1]") ;
define Rep2     Bit({p}, "[R2=0]", "[R2=1]") ;

! Both halves of the identifier are required, so a stroke missing -T or -Z has no
! path. That is the absence of the Python's `raise KeyError`.
define Fields     Pat Variant Rep1 AttachL Rep2 AttachR Cap [ {tz} .x. 0 ] ;
! Repeating the empty glyph says nothing.
define BareRepeat [ [ [ {f} ({r}) ({p}) ] | [ ({r}) {p} ] ]
                    ({b}) ({g}) {tz} ] ;
define Parse      [ [ Stroke - BareRepeat ] .o. Fields ] ;

! Glyph consumes only the pattern keys and the variant tag, so the modifier tags
! must be carried past it as identity or composition finds no path.
define ModTags [ "[R1=0]" | "[R1=1]" ] [ "[AL=0]" | "[AL=1]" ]
               [ "[R2=0]" | "[R2=1]" ] [ "[AR=0]" | "[AR=1]" ]
               [ "[C=0]" | "[C=1]" ] ;
define Glyph   GlyphPair ModTags ;

! ---- modifier logic, written once

define DoAttach [ "[AL=1]" -> "[ATTACH_L]" ,, "[AL=0]" -> 0 ,,
                  "[AR=1]" -> "[ATTACH_R]" ,, "[AR=0]" -> 0 ] ;
! A glyph that cases the next word and `-G` are one case, not two, and a record
! cannot hold two. `OneCase` is in the shared table, because both emily
! dictionaries read that glyph and both have a key that cases too.
define DoCap    [ [ "[C=1]" -> "[CAP_NEXT]" ,, "[C=0]" -> 0 ] .o. OneCase ] ;
define DoRep    [ [ "[R2=0]" -> 0        || "[R1=0]" ?* _ ,,
                    "[R2=1]" -> "[REP3]" || "[R1=0]" ?* _ ,,
                    "[R2=0]" -> "[REP2]" || "[R1=1]" ?* _ ,,
                    "[R2=1]" -> "[REP4]" || "[R1=1]" ?* _ ]
                  .o. [ [ "[R1=0]" | "[R1=1]" ] -> 0 ] ] ;
! A retrospective space edits the gap already written, so there is no glyph beside
! it for an attachment to close. -R and -B say nothing on those two rows.
define DoSpace  [ [ "[ATTACH_L]" | "[ATTACH_R]" ] -> 0
                  || [ "[CANCEL_SPACE]" | "[RETRO_SPACE]" ] ?* _ ] ;

! ---- numbers
!
! `U` with the identifier writes a number, the left bank read as binary exactly as
! `emily-modifiers` reads it in literal mode: `R W K S` are 1 2 4 8 and `H P T ^`
! are 16 32 64 128. `O` appends a zero, so `SROUTZ` is 90 and `OUTZ`, with no
! bits, is 0. Glued, as Plover glues a translation that is all digits. The table
! has `#` as 256, and `#` is phrasing's, so that bit is not read.
define Bits     [ [ \"#" ]+ .o. LitNum ] ;
define Number   [ [ Bits ([ {O} .x. {0} ]) | [ {O} .x. {0} ] ]
                  [ {Utz} .x. "[GLUE]" ] ] ;

define Grammar Canon([ [ Parse .o. Glyph .o. DoAttach .o. DoSpace
                         .o. DoRep .o. DoCap ] | Number ]) ;
