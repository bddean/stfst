! Phrasing, retroactively: a run of modifier strokes edits the clause it follows.
!
! `phrasing.py` §8 stacks modifiers after a clause and re-realizes the whole run on
! every lookup. This does the same thing, and the only thing it needs is the run in
! the other order.
!
! Chronological order is what makes it expensive. A modifier is read *after* the
! clause it changes and the text is written before it, so the transducer has to
! guess the delta, and one stroke has 3,072 distinct effects: 1.4M states for a
! single modifier. A window over the written text reads the keys first, but text
! does not determine a bundle, so it cost 4.8% of its answers and still passed
! 6.8GB. Newest-first, neither happens:
!
!     +*  /  +T      ->   it isn't
!     the delta first, so the replay emits incrementally, as one stroke does
!
! Two relations, and the second is where the cost is:
!
!     Net    a whole run to one net delta         15,839 states
!     Apply  a delta and a clause to a clause     13,882 states
!
! `Net` is why the run length does not matter. The deltas compose, so a run of any
! length collapses into one of 3,072 effects before the clause is read at all, and
! `Run` below is a Kleene star: this dictionary declares no longest key.

! ---- what a modifier stroke is
!
! It carries no referent and no verb, which leaves these keys.
define MStroke [ ("#") ("@") ("^") "+" ("S") ("A") ("O") ("*") ("E") ("U")
                 ("g") ("s") ("d") ("z") ] ;
define Run     [ MStroke [ Sep MStroke ]* ] ;

! ---- the net delta: nine fields, one symbol each
define Dfl  [ "[dc0]" | "[dcF]" | "[dcS]" ] ;
define Dq   [ "[dq0]" | "[dq1]" ] ;
define Dem  [ "[de0]" | "[de1]" | "[de2]" ] ;
define Dgr  [ "[dg0]" | "[dg1]" ] ;
define Dmo  [ "[dm-]" | "[dmc]" | "[dms]" | "[dmw]" ] ;
define Dpo  [ "[dp0]" | "[dp1]" ] ;
define Dpg  [ "[dG0]" | "[dG1]" ] ;
define Dpf  [ "[dU0]" | "[dU1]" ] ;
define Dpa  [ "[dD0]" | "[dD1]" ] ;
define Delta [ Dfl Dq Dem Dgr Dmo Dpo Dpg Dpf Dpa ] ;

! ---- accumulating a run into one delta
!
! Each field needs one or two bits of the run to decide it, so each one reads the
! run and appends its own symbol, and nine of those compose over a bit each.
! Absorbing stroke by stroke instead costs 3,072 states per absorber, because there
! the stroke is read before the delta it edits and the decision has to wait.
define Some(K) [ Run & [ ?* K ?* ] ] ;
define None(K) [ Run & ~[ ?* K ?* ] ] ;
define Even(K) [ Run & [ [ \K* K \K* K ]* \K* ] ] ;
define Odd(K)  [ Run - Even(K) ] ;
define Once(K) [ Run & [ \K* K \K* ] ] ;
define Twice(K)  [ Some(K) - Once(K) ] ;
! Negation and the question toggle, so a parity decides them. `@` counts instead,
! because the first one names the verb `do` and a second finds it there and becomes
! emphasis.
!
! Modality and the contraction mode are set absolutely, so the newest stroke that
! sets one wins. The tape is newest-first, so that is the *leftmost* such stroke,
! and `First` is a run whose earliest setter is an `S`.
define First(T, S)  [ Run & [ [ T Sep ]* S [ Sep MStroke ]* ] ] ;
define NoAO    [ MStroke & ~[ ?* "A" ?* ] & ~[ ?* "O" ?* ] ] ;
define WillS   [ MStroke & [ ?* "A" ?* ] & [ ?* "O" ?* ] ] ;
define CanS    [ MStroke & [ ?* "A" ?* ] & ~[ ?* "O" ?* ] ] ;
define ShallS  [ MStroke & ~[ ?* "A" ?* ] & [ ?* "O" ?* ] ] ;
! `^` is full mode and a bare `+` is the subject-clitic mode, "it's not" where the
! reduced form says "it isn't". Every other stroke leaves the mode alone.
define FullS   [ MStroke & [ ?* "^" ?* ] ] ;
define BareS   [ MStroke & [ "+" ] ] ;
define NoMode  [ MStroke - FullS - BareS ] ;

define A1  [ [ First(NoMode, FullS) [ 0 .x. "[dcF]" ] ]
           | [ First(NoMode, BareS) [ 0 .x. "[dcS]" ] ]
           | [ [ Run & [ NoMode [ Sep NoMode ]* ] ] [ 0 .x. "[dc0]" ] ] ] ;
define A2  [ [ Odd("#") Dfl [ 0 .x. "[dq1]" ] ] | [ Even("#") Dfl [ 0 .x. "[dq0]" ] ] ] ;
define A3  [ [ Once("@")  Dfl Dq [ 0 .x. "[de1]" ] ]
           | [ Twice("@") Dfl Dq [ 0 .x. "[de2]" ] ]
           | [ None("@")  Dfl Dq [ 0 .x. "[de0]" ] ] ] ;
define A4  [ [ [ Some("S") | Some("s") | Some("z") ] Dfl Dq Dem [ 0 .x. "[dg1]" ] ]
           | [ [ None("S") & None("s") & None("z") ] Dfl Dq Dem [ 0 .x. "[dg0]" ] ] ] ;
define A5  [ [ First(NoAO, WillS)  Dfl Dq Dem Dgr [ 0 .x. "[dmw]" ] ]
           | [ First(NoAO, CanS)   Dfl Dq Dem Dgr [ 0 .x. "[dmc]" ] ]
           | [ First(NoAO, ShallS) Dfl Dq Dem Dgr [ 0 .x. "[dms]" ] ]
           | [ [ None("A") & None("O") ] Dfl Dq Dem Dgr [ 0 .x. "[dm-]" ] ] ] ;
define A6  [ [ Odd("*") Dfl Dq Dem Dgr Dmo [ 0 .x. "[dp1]" ] ]
           | [ Even("*") Dfl Dq Dem Dgr Dmo [ 0 .x. "[dp0]" ] ] ] ;
define A7  [ [ [ Some("E") | Some("g") ] Dfl Dq Dem Dgr Dmo Dpo [ 0 .x. "[dG1]" ] ]
           | [ [ None("E") & None("g") ] Dfl Dq Dem Dgr Dmo Dpo [ 0 .x. "[dG0]" ] ] ] ;
define A8  [ [ Some("U") Dfl Dq Dem Dgr Dmo Dpo Dpg [ 0 .x. "[dU1]" ] ]
           | [ None("U") Dfl Dq Dem Dgr Dmo Dpo Dpg [ 0 .x. "[dU0]" ] ] ] ;
define A9  [ [ Some("d") Dfl Dq Dem Dgr Dmo Dpo Dpg Dpf [ 0 .x. "[dD1]" ] ]
           | [ None("d") Dfl Dq Dem Dgr Dmo Dpo Dpg Dpf [ 0 .x. "[dD0]" ] ] ] ;
define Net [ [ A1 .o. A2 .o. A3 .o. A4 .o. A5 .o. A6 .o. A7 .o. A8 .o. A9 ]
             .o. [ Kill(Run) Delta ] ] ;

! ---- applying the delta to the clause, once, whatever the run length
define SlotV  [ Adv | [ (SatPre) Lemma (SatPost) ] ] ;
define Slot   [ "[V0]" | SlotV ] ;
define Nom    [ [ "[SUBJ]" Word "[/SUBJ]" ("[C]") ] | "[INF]" | 0 ] ;
define Bun    [ ("[Q]") ("[EMPH]") Mode ("[AND]") Nom Agr Modl Pol Asp Tns Slot ] ;
! Each field of the clause has its own alphabet, so naming the new value places it
! and `Bun` is what pins where.
define At(R)  [ Bun .o. [ ?* R ?* ] ] ;
define OnD(V, A)  [ [ [ Delta & [ ?* V ?* ] ] A ] | [ [ Delta - [ ?* V ?* ] ] Bun ] ] ;

define AddPg [ [ "[SIMPLE]" .x. "[PROG]" ] | [ "[PROG]" .x. "[PROG]" ]
             | [ "[PERF]" .x. "[PERFPROG]" ] | [ "[PERFPROG]" .x. "[PERFPROG]" ] ] ;
define AddPf [ [ "[SIMPLE]" .x. "[PERF]" ] | [ "[PERF]" .x. "[PERF]" ]
             | [ "[PROG]" .x. "[PERFPROG]" ] | [ "[PERFPROG]" .x. "[PERFPROG]" ] ] ;
! `S` broadens, as everywhere: the pronoun pluralizes and agreement follows.
! "those" does not cliticize where "that" does, so the marker goes with the word.
define Grown [ [ "[SUBJ]" [ [ {I} .x. {we} ] | [ [ {he} | {she} | {it} ] .x. {they} ] ]
                 "[/SUBJ]" "[C]" ]
             | [ "[SUBJ]" [ {that} .x. {those} ] "[/SUBJ]" Kill("[C]") ]
             | [ "[SUBJ]" [ {this} .x. {these} ] "[/SUBJ]" ]
             | [ "[SUBJ]" [ Word - {I} - {he} - {she} - {it} - {this} - {that} ]
                 "[/SUBJ]" ("[C]") ] ] ;

define ApFl  [ [ [ Delta & [ ?* "[dcF]" ?* ] ] At([ Mode .x. "[FULL]" ])  ]
             | [ [ Delta & [ ?* "[dcS]" ?* ] ] At([ Mode .x. "[SCLIT]" ]) ]
             | [ [ Delta & [ ?* "[dc0]" ?* ] ] Bun ] ] ;
define ApPo  OnD("[dp1]", At([ [ "[AFF]" .x. "[NEG]" ] | [ "[NEG]" .x. "[AFF]" ] ])) ;
define ApPa  OnD("[dD1]", At([ Tns .x. "[PAST]" ])) ;
define ApPg  OnD("[dG1]", At(AddPg)) ;
define ApPf  OnD("[dU1]", At(AddPf)) ;
define ApQ   OnD("[dq1]", [ [ [ "[Q]" .x. 0 ] | [ 0 .x. "[Q]" ] ] ("[EMPH]") Mode
                            ("[AND]") Nom Agr Modl Pol Asp Tns Slot ]) ;
define ApGr  OnD("[dg1]", [ ("[Q]") ("[EMPH]") Mode ("[AND]")
                            [ Grown | "[INF]" | 0 ] [ Agr .x. "[pl]" ]
                            Modl Pol Asp Tns Slot ]) ;
! `@` on an empty verb slot names the verb `do`, exactly as an inline `@` does. A
! second one finds a verb there, so it does both.
define SetEm [ ("[Q]") [ [ 0 .x. "[EMPH]" ] | "[EMPH]" ] Mode ("[AND]")
               Nom Agr Modl Pol Asp Tns SlotV ] ;
define EmDo  [ ("[Q]") [ [ 0 .x. "[EMPH]" ] | "[EMPH]" ] Mode ("[AND]")
               Nom Agr Modl Pol Asp Tns [ "[V0]" .x. "[V:do]" ] ] ;
define ApEm  [ [ [ Delta & [ ?* "[de1]" ?* ] ] [ At([ "[V0]" .x. "[V:do]" ]) | SetEm ] ]
             | [ [ Delta & [ ?* "[de2]" ?* ] ] [ EmDo | SetEm ] ]
             | [ [ Delta & [ ?* "[de0]" ?* ] ] Bun ] ] ;
define ApMo  [ [ [ Delta & [ ?* "[dmw]" ?* ] ] At([ Modl .x. "[WILL]" ])  ]
             | [ [ Delta & [ ?* "[dmc]" ?* ] ] At([ Modl .x. "[CAN]" ])   ]
             | [ [ Delta & [ ?* "[dms]" ?* ] ] At([ Modl .x. "[SHALL]" ]) ]
             | [ [ Delta & [ ?* "[dm-]" ?* ] ] Bun ] ] ;
define Apply [ ApFl .o. ApQ .o. ApEm .o. ApGr .o. ApMo .o. ApPo .o. ApPa .o. ApPg
               .o. ApPf .o. [ Kill(Delta) Bun ] ] ;

! The outline is the run and then the clause it edits, so the tape is newest-first.
! The host has these strokes already, which is why this is cheap: the host does the
! remembering, and a transducer made to write the clause back out instead would pay
! the whole bundle space in states.
define Grammar  Canon([ [ Run Kill(Sep) Bundle ] .o. [ Net ?* ] .o. Apply
                        .o. [ Chain .o. Arrange ] ]) ;
