! Phrasing: a generative clause engine on the `#` namespace
! (~/.config/plover/PHRASING-DESIGN.md, revised by
! ~/.config/plover/phrasing-resdesign).
!
! This dictionary is the reason the format exists. Its table is millions of
! chords, too many for a dictionary file. Here it is a grammar.
!
! Three tapes, so that each layer names one thing and never the next one's
! alphabet. The format owns the word "record", so the middle tapes here are the
! feature *bundle* and the *chain*:
!
!   #^TP*  Chord    [FULL][SUBJ]it[/SUBJ][C][3sg][NOMOD][NEG][SIMPLE][PRES][V0]
!          Chain    [FULL][SUBJ]it[/SUBJ][C][3sg][NEG][PRES][F:be]
!          Arrange  it is not
!
! `Chord` reads keys and writes a feature bundle. `Chain` reads a bundle and
! builds the auxiliary chain: which auxiliary is finite, which are not, and what
! form the main verb takes. `Arrange` reads a chain and writes English: agreement,
! contraction and question inversion. Nothing in `Chain` mentions a key, and
! nothing in `Arrange` mentions an aspect.
!
! Both middle tapes are internal. Composition leaves their symbols in the
! alphabet and the compiler prunes them, so what reaches a host is keys to text.
!
! Two files hold what is a finite map by nature. `phrasing-subjects.xfst` is the
! subject sublanguage, hand-written, and it is where the design of the left bank
! lives. `phrasing-lexicon.xfst` is the right bank and the conjugation, generated
! from the mined verb table. Every rule is here.

define Kill(X)  [ X .x. 0 ] ;
define Say(X)   [ 0 .x. X ] ;
define SaySp    [ 0 .x. " " ] ;
define SayNot   [ 0 .x. [ " " {not} ] ] ;

! ---- the two internal alphabets

define Mode  [ "[RED]" | "[FULL]" ] ;
define Agr   [ "[1sg]" | "[3sg]" | "[pl]" ] ;
define Modl  [ "[NOMOD]" | "[CAN]" | "[SHALL]" | "[WILL]"
             | "[MAY]" | "[MUST]" | "[HAVETO]" | "[GOINGTO]" ] ;
define Pol   [ "[AFF]" | "[NEG]" ] ;
define Asp   [ "[SIMPLE]" | "[PERF]" | "[PROG]" | "[PERFPROG]" ] ;
define Tns   [ "[PRES]" | "[PAST]" ] ;
define Fid   [ "[F:be]" | "[F:have]" | "[F:do]"
             | "[F:can]" | "[F:shall]" | "[F:will]" | "[F:may]" | "[F:must]" ] ;
define Mid   [ "[M:have]" | "[M:be]" | "[M:been]" | "[M:being]" | "[M:going]" ] ;

! The question tag's subject pronoun, one symbol each (`phrasing-tag.xfst`).
define PronSym  [ "[P:I]" | "[P:you]" | "[P:he]" | "[P:she]" | "[P:it]" | "[P:we]"
                | "[P:they]" | "[P:there]" ] ;

define Feature  [ "[GAP]" | "[TAG]" | "[TW]" | PronSym | "[Q]" | Mode
                | "[SUBJ]" | "[/SUBJ]" | "[C]"
                | "[AND]" | "[IF]" | "[SO]" | "[INF]" | "[NOAUX]" | "[TO]"
                | Agr | Modl | Pol | Asp | Tns | "[V0]"
                | Lemma | SatPost | Art | Fid | Mid ] ;
! Anything that is not a feature symbol: the subject word, and the verb words
! that `Chain` has already spelled.
define Word     [ \Feature ]+ ;
define Chr      [ \Feature ] ;

! ============================================================== Chord: the keys
!
! The bundle is in key order, which is what keeps the lookup from guessing. Key
! order on this board is `🦐 # @ ^ + S T K P W H R A O * E U` then the right
! bank, and every feature is emitted where its key sits. The one exception is
! `K`, which is read before `T` so that the subject keys `T P W H` arrive
! together. `#` is the gate and writes nothing, and no entry has `@`.

define KFirst  [ ("🦐") "#" ("^") ("+") ("S")
                 [ [ [ "T" "K" ] .x. [ "K" "T" ] ] | "T" | ("K") ] \[ "T" | "K" ]* ] ;

! Modality is one dimension of eight over `R A O`.
define ModKeys  [ [ [ "R" "A" "O" ] .x. "[GOINGTO]" ] | [ [ "R" "A" ] .x. "[MUST]" ]
                | [ [ "R" "O" ] .x. "[HAVETO]" ] | [ "R" .x. "[MAY]" ]
                | [ [ "A" "O" ] .x. "[WILL]" ] | [ "A" .x. "[CAN]" ]
                | [ "O" .x. "[SHALL]" ] | Say("[NOMOD]") ] ;
define PolKey   [ [ "*" .x. "[NEG]" ] | Say("[AFF]") ] ;
define AspKeys  [ [ [ "E" "U" ] .x. "[PERFPROG]" ] | [ "E" .x. "[PROG]" ]
                | [ "U" .x. "[PERF]" ] | Say("[SIMPLE]") ] ;

! The empty verb slot denotes the copula (§5). The lone tense key past-shifts it
! -- `#TP-D` is "it was" -- and sits in no verb chord, so nothing is shadowed. A
! copula chord is the same slot with an article after it: `#T-FPTS` is "I'm a".
define EmptySlot [ [ Say("[PRES]") | [ "d" .x. "[PAST]" ] ] Say("[V0]") ] ;
define CopSlot  [ [ Say("[PRES]") Say("[V0]") CopPres ]
                | [ Say("[PAST]") Say("[V0]") CopPast ] ] ;
define VerbEnd  [ [ Say("[PRES]") RhsPres ] | [ Say("[PAST]") RhsPast ] ] ;
define Slot     [ EmptySlot | CopSlot | VerbEnd ] ;

! A left-key set that names no subject still heads a clause when the right bank
! names a verb: `#-B` is "adds". It gets no empty slot, because that would leave
! nothing to say.
define Cl(S, E)  [ S ModKeys PolKey AspKeys E ] ;

! A held subject holds the noun, so the clause already has a hole and cannot
! have a second one: no `-RG` verb. One record waits for one unit.
define NoVerbHole  ~[ ?* Hole ?* ] ;
define DetCl  [ Cl(Determiners, Slot) .o. NoVerbHole ] ;

! `🦐` holds the clause open before its verb, so the next stroke lands there:
! `🦐#T-R` then "often" is "I often run". It is a hole of its own, so it takes
! no held subject and no `-RG` verb either.
define OneHole  ~[ "[GAP]" ?* [ Hole | "[HOLD]" ] ?* ] ;

! "if" opens a statement with a subject: not a question, an infinitive or a
! clause with no subject.
define IfClause  [ ~[ ?* "[IF]" \"[SUBJ]" ?* ] & ~[ ?* "[Q]" ?* "[IF]" ?* ] ] ;

define Chord [ [ [ [ "🦐" .x. "[GAP]" ] | 0 ]
                 Kill("#")
                 [ [ "^" .x. "[FULL]" ] | Say("[RED]") ]
                 [ [ "+" .x. "[Q]" ] | 0 ]
                 [ [ "S" .x. "[AND]" ] | 0 ]
                 [ [ "K" .x. "[IF]" ] | 0 ]
                 [ Cl(Subjects, Slot)
                 | Cl(NoSubject, VerbEnd)
                 | DetCl ] ] .o. OneHole .o. IfClause ] ;

! "have to" and "used to" are lexical verbs with a "to" clause after them, so
! agreement and do-support need nothing new. "have to" takes the aspect itself:
! `#TROU-G` is "I've had to go". "used to" is the past of `use`, and the aspect
! goes to the main verb: `#TRAE-GD` is "I used to be going". An infinitive
! ignores modality, so neither applies there.
define UsedTo(A)  [ [ A .x. "[SIMPLE]" ] "[PAST]" Say([ "[V:use]" "[TO]" A ]) ] ;
define SemiVerb [ [ \Modl* [ "[HAVETO]" .x. "[NOMOD]" ] Pol Asp Tns
                    Say([ "[V:have]" "[TO]" "[SIMPLE]" ]) ?* ]
                | [ \Modl* [ "[MUST]" .x. "[NOMOD]" ] Pol
                    [ UsedTo("[SIMPLE]") | UsedTo("[PERF]")
                    | UsedTo("[PROG]") | UsedTo("[PERFPROG]") ] ?* ]
                | ~[ ?* [ "[HAVETO]" | [ "[MUST]" Pol Asp "[PAST]" ] ] ?* ] ] ;
define Finite  ~[ ?* "[INF]" ?* ] ;
define Semi  [ [ Finite .o. SemiVerb ] | ~Finite ] ;

define Bundle  [ KFirst .o. Chord .o. Semi ] ;

! =========================================================== Chain: the chain
!
! The chain is MODAL? (HAVE..en)? (BE..ing)? MAIN. The first element present is
! finite, the rest are mids, and every non-finite form is fixed by what precedes
! it -- so the corner that picks the finite auxiliary also picks the main verb's
! form, which is why those two travel together on every line below.
!
! `Gap` is where a held clause waits: after the finite word and before the rest
! of the chain, so "she has often gone" and "I don't often go". Where the chain
! has no finite word before the verb, it is before the verb: "I often go".

define KNo   Kill("[NOMOD]") ;
define KV0   Kill("[V0]") ;
define KSim  Kill("[SIMPLE]") ;
define KPf   Kill("[PERF]") ;
define KPg   Kill("[PROG]") ;
define KPP   Kill("[PERFPROG]") ;
define Gap   [ Say("[GAPAT]") | 0 ] ;
define ArtV0 [ KV0 (ArtW) ] ;

! The finite word: modality `K`, aspect `KA`, and `F` the auxiliary that carries
! tense. "must" has no past; `Semi` made its past "used to".
define Op(K, KA, T, F)  [ Agr Kill(K) Pol KA T Say(F) Gap ] ;
define NoMod(KA, F)  Op("[NOMOD]", KA, Tns, F) ;
! "going to" is a modal whose finite word is `be`, so it agrees and inverts.
define Modal(KA)  [ Op("[CAN]", KA, Tns, "[F:can]")
                  | Op("[SHALL]", KA, Tns, "[F:shall]")
                  | Op("[WILL]", KA, Tns, "[F:will]")
                  | Op("[MAY]", KA, Tns, "[F:may]")
                  | Op("[MUST]", KA, "[PRES]", "[F:must]")
                  | [ Op("[GOINGTO]", KA, Tns, "[F:be]") Say("[M:going]") ] ] ;

! A "to" clause, in base forms: the infinitive's, and what follows "have to" and
! "used to". `T` is what sits between the aspect and the verb. "to" always takes
! a verb, so an empty slot after it is "be".
define NonFin(T) [
    [ KSim T [ [ VBase (SatPostW) ] | [ Say([ " " {be} ]) ArtV0 ] ] ]
  | [ KPf  T Say([ " " {have} ])
        [ [ VPastpart (SatPostW) ] | [ Say([ " " {been} ]) ArtV0 ] ] ]
  | [ KPg  T Say([ " " {be} ])
        [ [ VPrespart (SatPostW) ] | [ Say([ " " {being} ]) ArtV0 ] ] ]
  | [ KPP  T Say([ " " {have} " " {been} ])
        [ [ VPrespart (SatPostW) ] | [ Say([ " " {being} ]) ArtV0 ] ] ] ] ;
define ToV  [ Kill("[TO]") Say([ " " {to} ]) NonFin(0) ] ;
define Verb(F)  [ F [ (SatPostW) | ToV ] ] ;

! `Cls` reads the verb slot. An empty slot under an operator does not surface
! (§7 scaffolding: "she would have"); an article after it needs the copula, in
! the form `B` the corner gives a verb: "she would be a", "she has been a".
define Cls(F, B)  [ KV0 | [ KV0 Say([ " " B ]) ArtW ] | Verb(F) ] ;

define SHave  Say("[M:have]") ;
define SBe    Say("[M:be]") ;
define SBeen  Say("[M:been]") ;
define SHvBn  Say([ "[M:have]" "[M:been]" ]) ;

define Corners [
    [ Modal(KSim)                Cls(VBase,     {be})    ]   ! she would go
  | [ Modal(KPf)  SHave          Cls(VPastpart, {been})  ]   ! she would have gone
  | [ Modal(KPg)  SBe            Cls(VPrespart, {being}) ]   ! she would be going
  | [ Modal(KPP)  SHvBn          Cls(VPrespart, {being}) ]   ! she would have been going
  | [ NoMod(KPf, "[F:have]")     Cls(VPastpart, {been})  ]   ! she has gone
  | [ NoMod(KPg, "[F:be]")       Cls(VPrespart, {being}) ]   ! she is going
  | [ NoMod(KPP, "[F:have]") SBeen Cls(VPrespart, {being}) ] ] ; ! she has been going

! The one corner with no auxiliary of its own: no modal, simple aspect. An empty
! slot there is the plain copula. Otherwise English supplies `do` when something
! needs carrying -- negation, a question, or the full form -- and without one the
! verb carries its own tense.
define Copula  [ NoMod(KSim, "[F:be]") ArtV0 ] ;
define DoSup(P)  [ Agr KNo P KSim Tns Say("[F:do]") Gap Verb(VBase) ] ;
define Bare(A, T)  [ Say("[NOAUX]") Kill(A) KNo Kill("[AFF]") KSim Kill(T) Gap ] ;
define NoAux [ [ Bare("[3sg]", "[PRES]")               Verb(V3sg)  ]
             | [ Bare([ "[1sg]" | "[pl]" ], "[PRES]")  Verb(VBase) ]
             | [ Bare(Agr, "[PAST]")                   Verb(VPast) ] ] ;

! A non-finite "to" clause has no subject and no agreement, so modality, tense
! and the question have nothing to inflect and are ignored. Negation is the "not
! to" form, and a clausal "and" precedes both. Its full form is "in order to".
!
! A held clause waits between the "to" and the rest: "to often run".
define InfMode(M, W)  [ Kill(M) [ Kill("[Q]") | 0 ]
                        [ [ "[AND]" .x. [ {and} " " ] ] | 0 ] Say(W) ] ;
define Infinitive [ [ InfMode("[RED]", 0) | InfMode("[FULL]", [ {in} " " {order} " " ]) ]
    Kill("[INF]") Kill(Agr) Kill(Modl)
    [ [ "[AFF]" .x. {to} ] | [ "[NEG]" .x. [ {not} " " {to} ] ] ]
    NonFin([ Kill(Tns) Gap ]) ] ;

! A question and the full form are read before the subject, so the branch that
! does do-support for them says so in its prefix.
define SubjRec  [ [ "[AND]" | 0 ] [ "[IF]" | 0 ]
                  [ [ "[SUBJ]" Word "[/SUBJ]" [ "[C]" | 0 ] ] | 0 ] ] ;
define PfxAny    [ Mode [ "[Q]" | 0 ] SubjRec ] ;
define PfxTrig   [ [ [ Mode "[Q]" ] | "[FULL]" ] SubjRec ] ;
define PfxNoTrig [ "[RED]" SubjRec ] ;

! `[GAP]` passes through, and a held clause has to have found a place to wait.
define Chain [ [ "[GAP]" | 0 ]
               [ [ PfxAny    Corners ]
               | [ PfxAny    Copula ]
               | [ PfxTrig   DoSup(Pol) ]
               | [ PfxNoTrig DoSup("[NEG]") ]
               | [ PfxNoTrig NoAux ]
               | Infinitive ] ] ;
define GapOnce  [ [ "[GAP]" \"[GAPAT]"* "[GAPAT]" \"[GAPAT]"* ]
                | ~[ ?* [ "[GAP]" | "[GAPAT]" ] ?* ] ] ;

! ========================================================== Arrange: English
!
! The closed-class irregulars, and nothing else is data here. Each table is keyed
! by only what its word depends on -- agreement and tense for `be`, `have` and
! `do`, tense alone for a modal -- which is what the projections below are for.

define BeA    [ [ [ "[1sg]" "[PRES]" ] .x. {am}  ] | [ [ "[3sg]" "[PRES]" ] .x. {is}   ]
              | [ [ "[pl]"  "[PRES]" ] .x. {are} ] | [ [ "[1sg]" "[PAST]" ] .x. {was}  ]
              | [ [ "[3sg]" "[PAST]" ] .x. {was} ] | [ [ "[pl]"  "[PAST]" ] .x. {were} ] ] ;
define BeN    [ [ [ "[3sg]" "[PRES]" ] .x. [ {isn}   "'" {t} ] ]
              | [ [ "[pl]"  "[PRES]" ] .x. [ {aren}  "'" {t} ] ]
              | [ [ "[1sg]" "[PAST]" ] .x. [ {wasn}  "'" {t} ] ]
              | [ [ "[3sg]" "[PAST]" ] .x. [ {wasn}  "'" {t} ] ]
              | [ [ "[pl]"  "[PAST]" ] .x. [ {weren} "'" {t} ] ] ] ;
define BeS    [ [ [ "[1sg]" "[PRES]" ] .x. [ "'" {m}  ] ]
              | [ [ "[3sg]" "[PRES]" ] .x. [ "'" {s}  ] ]
              | [ [ "[pl]"  "[PRES]" ] .x. [ "'" {re} ] ] ] ;
define HaveA  [ [ [ "[1sg]" "[PRES]" ] .x. {have} ] | [ [ "[3sg]" "[PRES]" ] .x. {has} ]
              | [ [ "[pl]"  "[PRES]" ] .x. {have} ] | [ [ Agr     "[PAST]" ] .x. {had} ] ] ;
define HaveN  [ [ [ "[1sg]" "[PRES]" ] .x. [ {haven} "'" {t} ] ]
              | [ [ "[3sg]" "[PRES]" ] .x. [ {hasn}  "'" {t} ] ]
              | [ [ "[pl]"  "[PRES]" ] .x. [ {haven} "'" {t} ] ]
              | [ [ Agr     "[PAST]" ] .x. [ {hadn}  "'" {t} ] ] ] ;
define HaveS  [ [ [ "[1sg]" "[PRES]" ] .x. [ "'" {ve} ] ]
              | [ [ "[3sg]" "[PRES]" ] .x. [ "'" {s}  ] ]
              | [ [ "[pl]"  "[PRES]" ] .x. [ "'" {ve} ] ]
              | [ [ Agr     "[PAST]" ] .x. [ "'" {d}  ] ] ] ;
define DoA    [ [ [ "[1sg]" "[PRES]" ] .x. {do}  ] | [ [ "[3sg]" "[PRES]" ] .x. {does} ]
              | [ [ "[pl]"  "[PRES]" ] .x. {do}  ] | [ [ Agr     "[PAST]" ] .x. {did}  ] ] ;
define DoN    [ [ [ "[1sg]" "[PRES]" ] .x. [ {don}   "'" {t} ] ]
              | [ [ "[3sg]" "[PRES]" ] .x. [ {doesn} "'" {t} ] ]
              | [ [ "[pl]"  "[PRES]" ] .x. [ {don}   "'" {t} ] ]
              | [ [ Agr     "[PAST]" ] .x. [ {didn}  "'" {t} ] ] ] ;
define CanA   [ [ "[PRES]" .x. {can}   ] | [ "[PAST]" .x. {could}  ] ] ;
define CanN   [ [ "[PRES]" .x. [ {can}    "'" {t} ] ]
              | [ "[PAST]" .x. [ {couldn} "'" {t} ] ] ] ;
define ShallA [ [ "[PRES]" .x. {shall} ] | [ "[PAST]" .x. {should} ] ] ;
define ShallN [ [ "[PAST]" .x. [ {shouldn} "'" {t} ] ] ] ;
define WillA  [ [ "[PRES]" .x. {will}  ] | [ "[PAST]" .x. {would}  ] ] ;
define WillN  [ [ "[PRES]" .x. [ {won}    "'" {t} ] ]
              | [ "[PAST]" .x. [ {wouldn} "'" {t} ] ] ] ;
define WillS  [ [ "[PRES]" .x. [ "'" {ll} ] ] | [ "[PAST]" .x. [ "'" {d} ] ] ] ;
define MayA   [ [ "[PRES]" .x. {may}   ] | [ "[PAST]" .x. {might}  ] ] ;
define MustA  [ "[PRES]" .x. {must} ] ;
define MustN  [ "[PRES]" .x. [ {mustn} "'" {t} ] ] ;

! The selector on the chain tape is `Agr Pol Tense Fid`. These drop what a word
! does not depend on, so each table above stays as small as English made it.
define PjAT   [ Agr Kill(Pol) Tns ] ;
define PjT    [ Kill(Agr) Kill(Pol) Tns ] ;

define AffW [ [ [ PjAT Kill("[F:be]")    ] .o. BeA    ]
            | [ [ PjAT Kill("[F:have]")  ] .o. HaveA  ]
            | [ [ PjAT Kill("[F:do]")    ] .o. DoA    ]
            | [ [ PjT  Kill("[F:can]")   ] .o. CanA   ]
            | [ [ PjT  Kill("[F:shall]") ] .o. ShallA ]
            | [ [ PjT  Kill("[F:will]")  ] .o. WillA  ]
            | [ [ PjT  Kill("[F:may]")   ] .o. MayA   ]
            | [ [ PjT  Kill("[F:must]")  ] .o. MustA  ] ] ;
! Partial by design: `am`, present `shall` and `may` have no contraction, so
! those selectors fall through to the separate `not` below.
define NegW [ [ [ PjAT Kill("[F:be]")    ] .o. BeN    ]
            | [ [ PjAT Kill("[F:have]")  ] .o. HaveN  ]
            | [ [ PjAT Kill("[F:do]")    ] .o. DoN    ]
            | [ [ PjT  Kill("[F:can]")   ] .o. CanN   ]
            | [ [ PjT  Kill("[F:shall]") ] .o. ShallN ]
            | [ [ PjT  Kill("[F:will]")  ] .o. WillN  ]
            | [ [ PjT  Kill("[F:must]")  ] .o. MustN  ] ] ;
! Also partial: `was`, `did` and the other modals do not cliticize, so the
! contraction dimension is inert there and needs no marker to say so.
define SufW [ [ [ PjAT Kill("[F:be]")   ] .o. BeS   ]
            | [ [ PjAT Kill("[F:have]") ] .o. HaveS ]
            | [ [ PjT  Kill("[F:will]") ] .o. WillS ] ] ;

define IsAff  [ Agr "[AFF]" Tns Fid ] ;
define IsNeg  [ Agr "[NEG]" Tns Fid ] ;

! A reduced modal perfect merges into the auxiliary: "could've". Only these
! five, because "can've" is not a word.
define ModVe [ [ [ "[PAST]" "[F:can]" ]   .x. [ {could}  "'" {ve} ] ]
             | [ [ "[PAST]" "[F:shall]" ] .x. [ {should} "'" {ve} ] ]
             | [ [ "[PAST]" "[F:will]" ]  .x. [ {would}  "'" {ve} ] ]
             | [ [ "[PAST]" "[F:may]" ]   .x. [ {might}  "'" {ve} ] ]
             | [ [ "[PRES]" "[F:must]" ]  .x. [ {must}   "'" {ve} ] ] ] ;
! A held clause waits between the finite word and the mids, so the `have` this
! swallows is not always the next symbol: "I could've often gone".
define Merge [ Kill(Agr) Kill("[AFF]") ModVe Chr* Kill("[M:have]") ] ;

! The mid slots, spelled. They are polarity-independent: only the finite head
! ever takes a negative form, so negation never reaches them.
define MidW  [ [ "[M:have]" .x. [ " " {have} ] ] | [ "[M:be]" .x. [ " " {be} ] ]
             | [ "[M:been]" .x. [ " " {been} ] ]
             | [ "[M:being]" .x. [ " " {being} ] ]
             | [ "[M:going]" .x. [ " " {going} " " {to} ] ] ] ;
define Tail  [ [ Chr | MidW ]* ] ;

! Two shapes, and every mode is one of them. A clause says its finite word after
! the subject; a clitic hangs the word on the subject instead and leaves any
! `not` behind. A question inverts the two, which costs nothing on a tape where
! the selector follows the subject. A clause with no subject at all -- `#E-B` is
! "are adding" -- is the same shapes with the head absent.
define SubjA  [ Kill("[SUBJ]") Word Kill("[/SUBJ]") [ Kill("[C]") | 0 ] ] ;
define SubjC  [ Kill("[SUBJ]") Word Kill("[/SUBJ]") Kill("[C]") ] ;
define AndW  [ [ [ "[AND]" .x. [ {and} " " ] ] | 0 ]
               [ [ "[IF]" .x. [ {if} " " ] ] | [ "[SO]" .x. [ {so} " " ] ] | 0 ] ] ;
define Decl(F, T)  [ Kill(Mode) AndW [ [ SubjA SaySp ] | 0 ] F T ] ;
define Clit(F, T)  [ Kill(Mode) AndW SubjC F T ] ;

! Inversion moves the selector in front of the subject, one symbol at a time, so
! that the same finite-word tables serve both orders. The transducer guesses each
! symbol before reading the subject, which nondeterminism makes free -- the same
! hoist the record language uses for its flags. A clausal "and" leads the whole
! clause, inverted or not, so it comes along.
define Pull(X)  [ [ 0 .x. X ] \X* [ X .x. 0 ] ?* ] ;
define PullAgr [ Pull("[1sg]") | Pull("[3sg]") | Pull("[pl]") ] ;
define PullPol [ Pull("[AFF]") | Pull("[NEG]") ] ;
define PullTns [ Pull("[PRES]") | Pull("[PAST]") ] ;
define PullFid [ Pull("[F:be]") | Pull("[F:have]")  | Pull("[F:do]")
               | Pull("[F:can]") | Pull("[F:shall]") | Pull("[F:will]")
               | Pull("[F:may]") | Pull("[F:must]") ] ;
define PullAnd [ Pull("[AND]") | ~[ ?* "[AND]" ?* ] ] ;
define Invert  [ PullFid .o. PullTns .o. PullPol .o. PullAgr .o. PullAnd ] ;

define Ques(F, T)  [ Invert .o.
                     [ AndW F Kill(Mode) Kill("[Q]") [ [ SaySp SubjA ] | 0 ] T ] ] ;

! The contraction dimension is chosen absolutely, never cycled, so each mode is
! a filter on the tape rather than a state.
define Full(B)  [ [ "[FULL]" ?* ] .o. B ] ;
define Red(B)   [ [ "[RED]" ?* ] .o. B ] ;

! Reduction is a preference, not a case: take the clitic where the tables allow
! one, else the contracted negative, else the full form. That is a priority
! union, and it is why the modes need no marker to tell them apart.
! `Chain` writes every word of a tail with the space that precedes it, which is
! the subject's space when there is a subject and nobody's when there is not.
define Arrange [
    [ Kill(Mode) AndW SubjA Kill("[NOAUX]") Tail ]
  | [ Kill(Mode) AndW Kill("[NOAUX]") Kill(" ") Tail ]
  | Tail
  | Full(Decl([ IsAff .o. AffW ], Tail))
  | Full(Decl([ IsNeg .o. AffW ], [ SayNot Tail ]))
  | Full(Ques([ IsAff .o. AffW ], Tail))
  | Full(Ques([ IsNeg .o. AffW ], [ SayNot Tail ]))
  | Red(Ques([ IsAff .o. AffW ], Tail))
  | Red(PU(Ques([ IsNeg .o. NegW ], Tail),
           Ques([ IsNeg .o. AffW ], [ SayNot Tail ])))
  | Red(PU(Clit([ IsAff .o. SufW ], Tail),
           PU(Decl(Merge, Tail),
              Decl([ IsAff .o. AffW ], Tail))))
  | Red(PU(Decl([ IsNeg .o. NegW ], Tail),
           PU(Clit([ IsNeg .o. SufW ], [ SayNot Tail ]),
              Decl([ IsNeg .o. AffW ], [ SayNot Tail ]))))
] ;

! `^` asks for the full form. Where a modal clause has nothing to contract, it
! writes "so" before the subject instead: `#^TA-G` is "so I can go" and
! `#^STA-G` "and so I can go". `Contracted` is every branch above that the
! reduced mode prefers to the full form, so a clause outside its domain reads
! the same either way. Only a statement whose subject is a word of its own:
! "so" before a question, "if", "what" or a held noun is not what `^` asked for.
define Contracted [ Ques([ IsNeg .o. NegW ], Tail)
                  | Clit([ IsAff .o. SufW ], Tail)
                  | Decl(Merge, Tail)
                  | Decl([ IsNeg .o. NegW ], Tail)
                  | Clit([ IsNeg .o. SufW ], [ SayNot Tail ]) ] ;
define OwnWord  [ Word - {what} - [ ?* "[HOLD]" ?* ] ] ;
define ModalCl  [ ?* [ "[F:can]" | "[F:shall]" | "[F:will]" | "[F:may]" | "[F:must]"
                     | "[M:going]" ] ?* ] ;
define FullSame  [ [ [ "[FULL]" ("[AND]") "[SUBJ]" OwnWord "[/SUBJ]" ?* ] & ModalCl ]
                   - Contracted.u ] ;
define SoMark  [ [ FullSame .o. [ "[FULL]" ("[AND]") Say("[SO]") ?* ] ] | ~FullSame ] ;

! The held subject's hole, closed. `Arrange` writes the subject and then the
! space before the next word, so the hole is always followed by that space and
! what comes after it is the tail: `the[HOLD] is adding` is "the" now and "is
! adding" after the noun. A hole with nothing after it holds nothing, because
! there is no tail to wait with, so `#+WH` is "is the" and the noun follows it as
! ordinary text.
define NoHold  ~[ ?* "[HOLD]" ?* ] ;
define CloseHole [
    NoHold
  | [ [ ?* "[HOLD]" " " ?* ] .o. [ "[HOLD]" " " -> "[AFTER]" ]
      .o. [ ?* [ 0 .x. "[END]" ] ] ]
  | [ [ ?* "[HOLD]" ] .o. [ "[HOLD]" -> 0 ] ] ] ;

! A bundle to English.
define Render  [ Chain .o. GapOnce .o. [ [ Kill("[GAP]") | 0 ] SoMark ] .o. Arrange ] ;

! A held clause's gap is the same kind of hole: the rest of the clause is the tail.
define Close  [ [ "[GAPAT]" -> "[HOLD]" ] .o. CloseHole ] ;
define Grammar  Canon([ Bundle .o. Render .o. Close ]) ;
