! Strokes contracted to one, marked with what caret.xfst does to it. After
! theory.xfst, or an outline's strokes.
!
! One stroke is the stroke, marked `-`, or the same keys marked `^`, which as
! the longer the resolver takes only where the plain stroke is taken: mare is
! mayor's `PHAEUR`, so it is `^PHAEUR`.
!
! Two strokes are the stressed one's, marked `^` and the other's operand,
! which caret.xfst XORs into the chord. The other stroke's consonants join the
! side of the stroke they are on, and those between the two cross to the
! stressed stroke's side, read by the key's sound (-PB is TPH, TK is -D).
!
!     report     1 R0E:E/P1:Ort    ->  1 ^E PROrt
!     happy      1 H1:Ap/0EU:EU    ->  1 ^EU HAp
!     pirouette  1 P0EU:EUr/W1:Et  ->  1 ^EU PWREt
!
! What stands for a dropped syllable is kept: a rewrite's `^`, which leaves no
! plain stroke, or a prefix's cluster, which takes the place of `^`.

! Keys crossing to the other bank, by their sound.
define ToLeft   [ {pblg} -> {SKWR} ] .o. [ {fp} -> {KH} ] .o. [ {rb} -> {SH} ] .o. [ {pb} -> {TPH} ]
            .o. [ {pl} -> {PH} ] .o. [ {bg} -> K ] .o. [ f -> {TP} ] .o. [ r -> R ] .o. [ p -> P ]
            .o. [ b -> {PW} ] .o. [ l -> {HR} ] .o. [ g -> {TKPW} ] .o. [ t -> T ] .o. [ s -> S ]
            .o. [ d -> {TK} ] .o. [ z -> S ] ;
define ToRight  [ {STKPW} -> z ] .o. [ {TKPW} -> g ] .o. [ {SKWR} -> {pblg} ] .o. [ {KWR} -> 0 ]
            .o. [ {TPH} -> {pb} ] .o. [ {PH} -> {pl} ] .o. [ {PW} -> b ] .o. [ {TK} -> d ] .o. [ {TP} -> f ]
            .o. [ {SR} -> f ] .o. [ {HR} -> l ] .o. [ {KH} -> {fp} ] .o. [ {SH} -> {rb} ] .o. [ {TH} -> t ]
            .o. [ K -> {bg} ] .o. [ S -> s ] .o. [ T -> t ] .o. [ P -> p ] .o. [ R -> r ] .o. [ W -> 0 ]
            .o. [ H -> 0 ] ;
define Crossed(Keys, To) [ Keys .o. To ] ;

! The other stroke: `~` and its operand, a trace that `Carry` moves to the
! mark, and its chord gone.
define Trace    [ "0":"~" (A) (O) (E) (U) ":":"~" Del(VowelKeys) ] ;
define Seam     "|" ;

! The mark: `^`, after a prefix's cluster if there is one.
define Caret    [ [ 0 | Del("^" Gap) | LeftKey+ Del(Gap) ] Ins("^" Gap) ] ;

define Single   [ Rank Gap [ Ins("-" Gap) | Ins("^" Gap) | Lead Gap ] LeftKey* Del("1" ":") VowelKeys RightKey* ] ;
define Second   [ Rank Gap Caret LeftKey* Trace Crossed(RightKey*, ToLeft) Del("/") Ins(Seam)
                  LeftKey* Del("1" ":") VowelKeys RightKey* ] ;
define First    [ Rank Gap Caret LeftKey* Del("1" ":") VowelKeys RightKey* Del("/") Ins(Seam)
                  Crossed(LeftKey*, ToRight) Trace RightKey* ] ;

! The trace's keys to the mark, the last first, so they land in steno order.
define TraceKey [ A | O | E | U ] ;
define Carry(K) [ [ ?* "^" Ins(K) [ ? - "~" ]* "~" [ TraceKey - K ]* Del(K) ?* ]
                | ~$[ "~" [ TraceKey - K ]* K ] ] ;
define Untrace  [ Carry(U) .o. Carry(E) .o. Carry(O) .o. Carry(A) .o. [ "~" -> 0 ] ] ;

! After keys the other stroke brought, the stressed stroke's onset loses an H
! or W that would make another chord with them (perhaps is not pl), and a y,
! which is the vowel's glide (do you).
define Alone    [ ? - LeftKey ] ;
define Combine  [ [ [ Seam H ] -> Seam || LeftKey _ Alone ] .o. [ [ Seam W ] -> Seam || [ P | K ] _ Alone ]
                .o. [ [ Seam {KWR} ] -> Seam || LeftKey _ Alone ] .o. [ Seam -> 0 ] ] ;

define Banks    [ Rank Gap [ ? - Gap ]* Gap [ LeftKey* .o. LeftBank ] VowelKeys [ RightKey* .o. RightBank ] ] ;

define Stage    [ Strokes .o. [ Single | Second | First ] .o. Untrace .o. Combine .o. Banks ] ;
