! The written-out form as one stroke's syllable: a mark, then the onset, the
! chord and the coda, which theory.xfst writes as keys and caret.xfst marks.
! After written.xfst and whatever rewrites it.
!
! One vowel is the syllable as it is, marked `-`, or the same keys marked `^`,
! which as the longer the resolver takes only where the plain stroke is taken:
! mare is mayor's `PHAEUR`, so it is `^PHAEUR`.
!
! Two vowels are one syllable around the stressed one, marked `^` and the keys
! the other vowel's operand gives (`Operand`), which caret.xfst XORs into the
! chord. Every consonant before the stressed vowel is the onset and every one
! after it the coda.
!
!     report   1 R=r 0:e=E P=p 1:o=O R.T=rt     ->  1 ^E R.P=p O R.T=rt
!     happy    1 HH=h 1:a=A P=pp 0:y=EU =       ->  1 ^EU HH=h A P=-
!     mother   1 M=m 1:o=O DH=th 0r:e=E R=r     ->  1 ^ M=m O DH.R=-
!
! The onset's letters are the stressed syllable's own, and so are the coda's
! when it is the last syllable. When the first vowel has the stress, the coda
! spans the second and its letters are `-`: it is read by sound. Z spelled s
! is S at the start.
!
! What stands for a dropped syllable is kept: a rewrite's `^`, which leaves no
! plain stroke, or a prefix's cluster, which takes the place of `^` (display is
! `STK P.L=pl EY A =`).

! A cluster's phonemes with the dots dropped, each read through C, and one of
! at least one phoneme. `Dots` puts them back once the syllable is written.
define Bare(C)  [ ( C [ Del(Dot) C ]* ) ] ;
define Bare1(C) [ C [ Del(Dot) C ]* ] ;
define Dots     [ [..] -> Dot || .#. Rank Gap [ ? - Gap ]* Gap ?* Cons _ Cons ] ;

define NoZ      [ [ Cons - Z ] | Z:S ] ;

! The keys the other vowel XORs: its first letter's (a A, e E, i and y EU, o O,
! u U), and none for an r-coloured vowel, whose R is on a bank already.
! `DigraphOp` XORs a vowel of two letters or more as its chord instead; the
! corpus did not favour it (notes/theory-systematize.md).
define FirstLetter [ a:A | e:E | [ i .x. [ E U ] ] | o:O | u:U | [ y .x. [ E U ] ] ] ;
define LetterOp [ Del(Level) [ Del(r ":" Letter+ Eq VowelKeys) | Del(":") FirstLetter Del(Letter* Eq VowelKeys) ] ] ;
define ChordOp  [ Del(Level) [ Del(r ":" Letter+ Eq VowelKeys) | Del(":" Letter+ Eq) (A) (O) (Del("*")) (E) (U) ] ] ;
define DigraphOp [ [ [ ?* ":" Letter Letter+ Eq ?* ] .o. ChordOp ] | [ [ ?* ":" Letter Eq ?* ] .o. LetterOp ] ] ;
define Operand  LetterOp ;

! The stressed vowel as its keys, and the other one as a trace, `~` and its
! operand, which `Carry` moves to the mark.
define Keys1(L) [ [ "1" ( r ) ":" L Eq VowelKeys ] .o. [ Del([ ? - Eq ]* Eq) VowelKeys ] ] ;
define Other(L) [ [ Level ( r ) ":" L Eq VowelKeys ] .o. [ Ins("~") Operand ] ] ;
define Tail1    [ Gap LastSeg ( Gap Suffix ) ] ;

! The mark: `^`, after a prefix's cluster if there is one.
define Caret    [ [ 0 | Del("^" Gap) | LeftKey+ Del(Gap) ] Ins("^" Gap) ] ;

define Single(C) [ Rank Gap [ Ins("-" Gap) | Ins("^" Gap) | Lead Gap ]
                   Bare(C) Eq Letter* Gap Del(Level ( r ) ":" Letter+ Eq) VowelKeys Tail1 ] ;

! The second vowel has the stress. The first's letters are one of a run that
! is two vowels (react) exactly when nothing comes between the two, and then a
! y after them is the onset's (cayenne).
define Weak(L)  [ [ [ "0" | "2" ] ?* ] .o. Other(L) ] ;
define Second(C) [ Rank Gap Caret Bare(C) Del(Eq Letter* Gap)
    [ Weak(Letter) Del(Gap) Eq Gap Keys1(Letter+ - [ y VowelLetter ?* ])
    | Weak(Letter+) Del(Gap) Bare1(C) Eq Letter* Gap Keys1(Letter+) ] Tail1 ] ;

! The first vowel has the stress. A final e is a vowel only in -le and -re
! (little, acre), and a run of letters that is two vowels is one vowel group.
define FirstShape [ ~[ Rank Gap ( Lead Gap ) ConsSeg Gap "1" ( r ) ":" Letter Eq VowelKeys Gap Phones Eq Gap ?* ]
    & ~[ ?* Gap Phones Eq [ Letter* - [ Letter* [ l | r ] ] ] Gap [ "0" | "2" ] ( r ) ":" e Eq VowelKeys Gap Phones Eq ( Gap Suffix ) ]
    & ~[ ?* "_" u e ?* ] ] ;
define First(C) [ Rank Gap Caret Bare(C) Eq Letter* Gap Keys1(Letter+) Gap
    Bare(Cons) Del(Eq Letter* Gap) Other(Letter+) Del(Gap) Bare(Cons) Del(Eq Letter* ( Tail )) Ins(Eq "-")
    ( Gap Suffix ) ] ;

! The trace's keys to the mark, the last first, so they land in steno order.
define TraceKey [ A | O | E | U ] ;
define Carry(K) [ [ ?* "^" Ins(K) [ ? - "~" ]* "~" [ TraceKey - K ]* Del(K) [ 0 | [ ? - TraceKey ] ?* ] ]
                | ~$[ "~" TraceKey* K ] ] ;
define Untrace  [ Carry(U) .o. Carry(E) .o. Carry(O) .o. Carry(A) .o. [ "~" -> 0 ] ] ;

! The last onset Y of two phonemes or more is the vowel's glide (accuse).
define Glide    [ Rank Gap [ ? - Gap ]* Gap [ [ Cons+ Del(Y) ] | [ Cons* - [ Cons+ Y ] ] ] Eq ?* ] ;

define Shapes(C) [ Single(C) | Second(C) | [ FirstShape .o. First(C) ] ] ;
define Contract [ Written .o. [ [ ~$[z] .o. Shapes(NoZ) ] | [ $[z] .o. Shapes(Cons) ] ] .o. Untrace .o. Glide .o. Dots ] ;

define Stage    Contract ;
