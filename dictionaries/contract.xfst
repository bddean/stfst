! Strokes contracted to one, marked with what caret.xfst does to it. After
! theory.xfst, or an outline's strokes.
!
! One stroke is the stroke, marked `-`.
!
! Two strokes are the stressed one's, marked `^` and the other's operand, its
! vowel's first letter, which caret.xfst writes as a mark. The other stroke's
! consonants join the side of the stroke they are on, and those between the
! two cross to the stressed stroke's side, read by the key's sound (-PB is
! TPH, TK is -D).
!
! On the left bank, the keys of each chord stay next to each other. So the
! word's onset stays, then the stressed onset where it splits nothing, then
! each sound that crossed where it splits neither (frontier is +TPRAOER, with
! no N and no H).
!
!     report     1 R0E:E/P1:Ort    ->  1 ^E PROrt
!     happy      1 H1:Ap/0EU:EU    ->  1 ^EU HAp
!     pirouette  1 P0EU:EUr/W1:Et  ->  1 ^EU PWREt
!
! What stands for a dropped syllable is kept: a rewrite's `^`, which leaves no
! plain stroke, or a prefix's cluster, which takes the place of `^`.

! Keys crossing to the other bank, by their sound.
define Sep      "," ;
define ToLeft   [ {pblg} -> {KWH} Sep ] .o. [ {fp} -> {KH} Sep ] .o. [ {rb} -> {SH} Sep ]
            .o. [ {pb} -> {TPH} Sep ] .o. [ {pl} -> {PH} Sep ] .o. [ {bg} -> K Sep ] .o. [ f -> {TP} Sep ]
            .o. [ r -> R Sep ] .o. [ p -> P Sep ] .o. [ b -> {PW} Sep ] .o. [ l -> {HR} Sep ]
            .o. [ g -> {TKPW} Sep ] .o. [ t -> T Sep ] .o. [ s -> S Sep ] .o. [ d -> {TK} Sep ]
            .o. [ z -> S Sep ] ;
define ToRight  [ {STKPW} -> z ] .o. [ {TKPW} -> g ] .o. [ {KWH} -> {pblg} ] .o. [ {KWR} -> 0 ]
            .o. [ {TPW} -> f ] .o. [ {TPH} -> {pb} ] .o. [ {PH} -> {pl} ] .o. [ {PW} -> b ] .o. [ {TK} -> d ]
            .o. [ {TP} -> f ] .o. [ {HR} -> l ] .o. [ {KH} -> {fp} ] .o. [ {SH} -> {rb} ] .o. [ {TH} -> t ]
            .o. [ K -> {bg} ] .o. [ S -> s ] .o. [ T -> t ] .o. [ P -> p ] .o. [ R -> r ] .o. [ W -> 0 ]
            .o. [ H -> 0 ] ;
define Crossed(Keys, To) [ Keys .o. To ] ;

! The other stroke: `~` and its operand, a trace that `Carry` moves to the
! mark, and its chord gone.
define Trace    [ "0":"~" (A) (O) (E) (U) ":":"~" Del(VowelKeys) ] ;
define Seam     "|" ;

! The mark: `^`, after a prefix's cluster if there is one.
define Caret    [ [ 0 | Del("^" Gap) | LeftKey+ Del(Gap) ] Ins("^" Gap) ] ;

define Single   [ Rank Gap [ Ins("-" Gap) | Lead Gap ] LeftKey* Del("1" ":") VowelKeys RightKey* ] ;
define Second   [ Rank Gap Caret LeftKey* Ins(Sep) Trace Crossed(RightKey*, ToLeft) Del("/") Ins(Seam)
                  LeftKey* Del("1" ":") VowelKeys RightKey* ] ;
define First    [ Rank Gap Caret LeftKey* Del("1" ":") VowelKeys RightKey* Del("/") Ins(Seam)
                  Crossed(LeftKey*, ToRight) Trace RightKey* ] ;

! The trace's keys to the mark, the last first, so they land in steno order.
define TraceKey [ A | O | E | U ] ;
define Carry(K) [ [ ?* "^" Ins(K) [ ? - "~" ]* "~" [ TraceKey - K ]* Del(K) ?* ]
                | ~$[ "~" [ TraceKey - K ]* K ] ] ;
define Untrace  [ Carry(U) .o. Carry(E) .o. Carry(O) .o. Carry(A) .o. [ "~" -> 0 ] ] ;

! After keys the other stroke brought, the stressed stroke's onset loses an H
! or W that would make another chord with them (perhaps is not pl), and a y,
! which is the vowel's glide (do you).
define Alone    [ ? - LeftKey ] ;
define Combine  [ [ [ Seam H ] -> Seam || LeftKey Sep* _ Alone ] .o. [ [ Seam W ] -> Seam || [ P | K ] Sep* _ Alone ]
                .o. [ [ Seam {KWR} ] -> Seam || LeftKey Sep* _ Alone ] ] ;

! A d that crosses to a stressed v is the two sounds' one chord: advice is +TKW.
define Dv       [ [ {TK} Sep Seam {TPW} ] -> [ Seam {TKW} ] || _ Alone ] ;

! The left bank of a stroke that crossed: the word's onset, each sound that
! crossed, and the stressed onset. A chord with keys on both sides of K and not
! K, `Lo+ Hi+`, is split by a chord that has K.
define Chord    [ (S) (T) (K) (P) (W) (H) (R) ] ;
define Sound    [ {KWH} | {KH} | {SH} | {TPH} | {PH} | K | {TP} | R | P | {PW} | {HR} | {TKPW} | T | S | {TK} ] ;
define Piece    [ Sound Sep ] ;
define Bank     [ Chord Sep Piece* Seam Chord ] ;
define Has(K)   [ Chord & $[K] ] ;
define Split(Lo, Hi) [ Chord & [ Lo+ Hi+ ] ] ;
define Drop(X)  [ [ Piece - [ X Sep ] ] | Del(X Sep) ]* ;

define OnsetFits(X, Y) [ [ X Sep Piece* Seam Del(Y) ] | [ Y Sep Piece* Seam Del(X) ]
                       | [ Bank - [ X Sep Piece* Seam Y ] - [ Y Sep Piece* Seam X ] ] ] ;
define SoundFits(X, Y) [ [ [ X Sep Drop(Y) Seam Chord ] | [ Y Sep Drop(X) Seam Chord ]
                         | [ [ Chord - X - Y ] Sep Piece* Seam Chord ] ]
                     .o. [ [ Chord Sep Drop(Y) Seam X ] | [ Chord Sep Drop(X) Seam Y ]
                         | [ Chord Sep Piece* Seam [ Chord - X - Y ] ] ] ] ;

define SpT      Split(S, [ K | P | W | H | R ]) ;
define SpK      Split([ S | T ], [ P | W | H | R ]) ;
define SpP      Split([ S | T | K ], [ W | H | R ]) ;
define SpW      Split([ S | T | K | P ], [ H | R ]) ;
define SpH      Split([ S | T | K | P | W ], R) ;
define Fit      [ OnsetFits(SpT, Has(T)) .o. OnsetFits(SpK, Has(K)) .o. OnsetFits(SpP, Has(P))
              .o. OnsetFits(SpW, Has(W)) .o. OnsetFits(SpH, Has(H))
              .o. SoundFits(SpT, Has(T)) .o. SoundFits(SpK, Has(K)) .o. SoundFits(SpP, Has(P))
              .o. SoundFits(SpW, Has(W)) .o. SoundFits(SpH, Has(H)) ] ;
define Fitted   [ [ Rank Gap [ ? - Gap ]* Gap Fit VowelKeys RightKey* ] | ~$[ Sep ] ] ;
define Close    [ [ Seam | Sep ] -> 0 ] ;

! F and B that share their P would read as v.
define FB       [ [ {TP} (R) Sep Piece* Seam {PW} (R) ] | [ {PW} (R) Sep Piece* Seam {TP} (R) ] ] ;
define NotFB    ~$[ Gap FB Alone ] ;

define Banks    [ Rank Gap [ ? - Gap ]* Gap [ LeftKey* .o. LeftBank ] VowelKeys [ RightKey* .o. RightBank ] ] ;

define Stage    [ Strokes .o. [ Single | Second | First ] .o. Untrace .o. Combine .o. Dv .o. Fitted .o. NotFB .o. Close .o. Banks ] ;
