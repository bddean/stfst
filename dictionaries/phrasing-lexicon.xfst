! Adverb enders (§4.6). Each one carries the hole: an
! adverb inflects for nothing, so a clause that ends on one
! has no verb to inflect either, and the word written next
! is that verb. `-d` is the tense it always was.
define Adv [
    "[ADV:often]" | "[ADV:never]" | "[ADV:just]" | "[ADV:also]" | "[ADV:actually]" | "[ADV:always]" |
    "[ADV:still]" | "[ADV:really]" ] ;

