! The unstressed syllable a word starts with, dropped, after suffix.xfst. `^`
! stands for it, so the rest is never a plain stroke, and after a prefix's
! cluster the cluster stands for both (disappoint). A nasal that closes the
! syllable goes with it (un, in, con).
!
! A syllable with no onset, or con or com, is dropped first, and the word as
! it was is one rewrite later. Any other is dropped one rewrite later.
!
!     append     1 = 0:a=A P=pp 1:e=E N.D=nd           ->  1 ^ P=pp 1:e=E N.D=nd
!     container  1 K=c 0:o=O N.T=nt 1:ai=A*EU N=n ...  ->  1 ^ T=t 1:ai=A*EU N=n ...
!     police     1 P=p 0:o=O L=l 1:i=AOE S=c_e         ->  1' ^ L=l 1:i=AOE S=c_e

define Mark     [ Ins("^" Gap) | Lead Gap ] ;
define Nasal    [ [ M | N | NG ] .x. 0 ] ;
define Opening  PU([ Nasal Del(Dot) More Eq Del([ m | n ]+) Letter* ], ConsSeg) ;
define Drop(On, V) [ [ Rank Gap Mark Del(On Gap "0" ( r ) ":" V Eq VowelKeys Gap) Opening Gap ?* ] .o. Written
                     .o. Flagged(Dropped) ] ;

define Light    [ Drop(Eq, Letter+) | Drop(K Eq c, o) ] ;
define Heavy    [ ~Light.u .o. Drop(More Eq Letter*, Letter+) ] ;

define Stage    [ [ Written .o. Before(Light) .o. After(Heavy) ] | Outlined ] ;
