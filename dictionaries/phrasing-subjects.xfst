! The nominal sublanguage: left keys to a subject and its agreement.
!
! Hand-written, and the source. Change the left bank here.
!
! The subject is a function of four keys, `T P W H`, and all sixteen sets mean
! something. `S` and `K` are the clausal conjunctions and `R` is modality, so
! none of them is read here. `phrasing.xfst` reads `K` before `T`, so the
! subject keys arrive together and each row below is in tape order.
!
! `[C]` marks a subject the reduced surface may cliticize onto ("it's", "I'm").
! `[INF]` is the nonfinite "to" clause, which has no subject word.
!
! The rules that read this map are in `phrasing.xfst`; the mined verb lexicon is
! in `phrasing-lexicon.xfst`.

! Twelve of the sixteen sets. Two more are the held subjects in `Determiners`
! below, and two head a clause only when a verb follows, in `NoSubject`.
define Subjects [
    [ [ "T" ] .x. [ "[SUBJ]" {I} "[/SUBJ]" "[C]" "[1sg]" ] ] |
    [ [ "P" ] .x. [ "[SUBJ]" {you} "[/SUBJ]" "[C]" "[pl]" ] ] |
    [ [ "H" ] .x. [ "[SUBJ]" {he} "[/SUBJ]" "[C]" "[3sg]" ] ] |
    [ [ "P" "H" ] .x. [ "[SUBJ]" {she} "[/SUBJ]" "[C]" "[3sg]" ] ] |
    [ [ "T" "P" ] .x. [ "[SUBJ]" {it} "[/SUBJ]" "[C]" "[3sg]" ] ] |
    [ [ "T" "H" ] .x. [ "[SUBJ]" {we} "[/SUBJ]" "[C]" "[pl]" ] ] |
    [ [ "T" "P" "H" ] .x. [ "[SUBJ]" {they} "[/SUBJ]" "[C]" "[pl]" ] ] |
    [ [ "T" "W" ] .x. [ "[SUBJ]" {that} "[/SUBJ]" "[C]" "[3sg]" ] ] |
    [ [ "P" "W" ] .x. [ "[SUBJ]" {this} "[/SUBJ]" "[3sg]" ] ] |
    [ [ "P" "W" "H" ] .x. [ "[SUBJ]" {what} "[/SUBJ]" "[C]" "[3sg]" ] ] |
    [ [ "T" "W" "H" ] .x. [ "[INF]" "[3sg]" ] ] |
    [ [ "T" "P" "W" "H" ] .x. [ "[SUBJ]" {there} "[/SUBJ]" "[C]" "[3sg]" ] ] ] ;

! No subject: the clause is its verb, so a verb is required. `W` is the plural
! agreement: `#-B` is "adds" and `#W-B` "add".
define NoSubject [
    [ [ 0 ] .x. [ "[3sg]" ] ] |
    [ [ "W" ] .x. [ "[pl]" ] ] ] ;

! "a" or "an", chosen by the word after it: the pattern `AEU` in `user.json`
! uses, which is Plover's.
define AOrAn [ "[IF_NEXT]"
    {[AaIi]|(?i:e(?:[^uw]|$)|ew(?:[^e]|$)|o(?:[^n]|$)|on(?:[^ce]|$)|oner|onc(?:[^e]|$)|}
    {hour|honest|honou?r|heir)|[Uu](?:[cdehjlmpqwxyz]|n(?:[^ai]|$)|na(?:[^n]|$)|}
    {nan(?:[^i]|$)|ni[^cfoqstvxl]|nill|s(?:[^aeiu]|$)|t(?:[^aeiou]|$)|r(?:[^aeiu]|$)|}
    {b(?:[^i]|$)|g(?:[^a]|$))|[FHLMNRSX](?:[B-DF-HJ-NP-TV-Z]|[^A-Za-z]|$)|8|}
    {1[18](?:[^0-9]|$)}
    "[THEN]" {an} "[ELSE]" {a} "[END]" ] ;

! A held subject: the determiner, and the noun is the word you write next.
! `[HOLD]` is where it goes, and `phrasing.xfst` turns it into the record's
! `[AFTER]`, so `#WH-B` then "dog" is "the dog adds".
define Determiners [
    [ [ "W" "H" ] .x. [ "[SUBJ]" {the} "[HOLD]" "[/SUBJ]" "[3sg]" ] ] |
    [ [ "T" "P" "W" ] .x. [ "[SUBJ]" AOrAn "[HOLD]" "[/SUBJ]" "[3sg]" ] ] ] ;
