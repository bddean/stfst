! Two words of one syllable contracted to one stroke, the rule of the two-word
! dictionary: contract.xfst's rule, with the word boundary where a word's
! syllables meet. After written.xfst and contract.xfst, whose pieces it shares.
!
! An entry is two written-out words joined by `+`, the stressed word's vowel 1
! and the other's 0. The stressed word's vowel is the syllable's and the other's
! is the mark, as in contract.xfst, and the other word's consonants join the
! side of the syllable they are on.
!
!     go home   1 G=g 0:o=O = + HH=h 1:o=OE M=m_e  ->  1 ^O G.HH=h OE M=m_e
!     what it   1 W=wh 1:a=A T=t + 0:i=EU T=t      ->  1 ^EU W=wh A T=-
!     make it   1 M=m 1:a=AEU K=k_e + 0:i=EU T=t   ->  1 ^EU M=m AEU K.T=-
!
! The onset's letters are the stressed word's own. A coda that spans the
! boundary is read by sound. A consonant on both sides of the boundary is said
! once.

! The second word has the stress, and the first word's consonants open it.
define PairSecond(C) [ Rank Gap Caret Bare(C) Del(Eq Letter* Gap) Other(Letter+) Del(Gap)
    Bare(C) Del(Eq Letter* ( Tail ) Plus) Bare(C) Eq Letter* Gap Keys1(Letter+) Tail1 ] ;

! The first word has the stress, and the second word's consonants close it.
define PairFirst(C) [ Rank Gap Caret Bare(C) Eq Letter* Gap Keys1(Letter+) Gap
    Bare(Cons) Del(Eq Letter* ( Tail ) Plus) Bare(Cons) Del(Eq Letter* Gap) Other(Letter+) Del(Gap)
    Bare(Cons) Del(Eq Letter* ( Tail )) Ins(Eq "-") ] ;

define Once(X)  [ [ X X ] -> X ] ;
define Degeminate [ Once(B) .o. Once(CH) .o. Once(D) .o. Once(DH) .o. Once(F) .o. Once(G) .o. Once(HH)
                  .o. Once(JH) .o. Once(K) .o. Once(L) .o. Once(M) .o. Once(N) .o. Once(NG) .o. Once(P)
                  .o. Once(R) .o. Once(S) .o. Once(SH) .o. Once(T) .o. Once(TH) .o. Once(V) .o. Once(W)
                  .o. Once(Y) .o. Once(Z) .o. Once(ZH) ] ;

define PairShapes(C) [ PairSecond(C) | PairFirst(C) ] ;
define ContractPair [ WrittenPair .o. [ [ ~$[z] .o. PairShapes(NoZ) ] | [ $[z] .o. PairShapes(Cons) ] ]
                      .o. Untrace .o. Glide .o. Degeminate .o. Dots ] ;

define Stage    ContractPair ;
