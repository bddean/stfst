! 5 onsets by sound and spelling.
define OnsetSpelled [ [ [ 0 Eq {h} ] .x. [ {H} ] ]
    | [ [ HH Eq {wh} ] .x. [ {WH} ] ]
    | [ [ K Eq {ch} ] .x. [ {KH} ] ]
    | [ [ R Eq {wr} ] .x. [ {WR} ] ]
    | [ [ W Eq {wh} ] .x. [ {WH} ] ] ] ;

! a after w or qu
define VowelRule1 [ [ Letter* [ {w} | {qu} ] ] Gap [ [ [ AA | AH | AAR | AOR ] Eq [ {a} ] ] .x. [ A ] ] ] ;
! a as aw or ah
define VowelRule2 [ Letter* Gap [ [ [ AA | AO ] Eq [ {a} | {a_e} ] ] .x. [ A U ] ] ] ;
! a
define VowelRule3 [ Letter* Gap [ [ ? Eq [ {a} ] ] .x. [ A ] ] ] ;
