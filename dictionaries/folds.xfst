! Folds: a stroke nothing matched, read as another stroke with something
! written around it. `stfst_core::fold` is the record and what a host does
! with it.
!
!   KAOEPT   -T off, KAOEP is "keep", then "the"       keep the
!   SKAOFL   -F off, SKAOL is "school", then "of"      school of
!   TAPGS    -S off, TAPG is "tapping", then -s         tappings
!   SKPAD    S-K-P- off, "and", then AD is "add"        and add
!
! A record lists alternatives, and the host takes the first whose base
! translates. Each names the keys it takes off and puts on rather than the
! base, so the automaton never copies a stroke:
!
!   [FOLD] before [STRIP] keys ([ADD] keys) [END] after
!
! "and" comes first, then the suffixes in Plover's order for its suffix keys,
! then the folds that write a word beside the base.
! A suffix on an "and" brief is junk (SKPA is "and a", so SKPAD would be "and
! aed"), and the "and" alternative needs its base to be a word, so where it is
! not the suffix still applies: SKPAOEPT is "and keep" and then "the".

define Say(X)   [ 0 .x. X ] ;

! ---- what the keys write

define Infl(M)  [ "[META=infl]" M "[END]" ] ;

! A suffix key alone inflects the word before it.
define Bare     [ [ z .x. Infl({ofz}) ] | [ d .x. Infl({ed}) ]
                | [ s .x. Infl({ofs}) ] | [ g .x. Infl({ing}) ] ] ;

! ---- the alternatives
!
! Each rule reads the stroke and adds its alternative after the ones before
! it, where the stroke is one it applies to. So the rules compose in the order
! the host tries them.

define Alts       [ "[FOLD]" ?* ] ;
define Rule(C, O) [ [ C (Alts) Say(O) ] | [ [ Stroke - C ] (Alts) ] ] ;

! A key and something else, because the base has to be a stroke too.
define Suffix(K, R)  Rule([ [ Stroke & $[K] ] - K ],
                          [ "[FOLD]" "[STRIP]" K "[END]" R ]) ;

! "and" is S-K-P- on a base that holds none of them. T- sorts inside the chord
! (STKP), so a word that begins with it drops it and the host puts it back:
! SKPEPB is "and then". Which base goes first is a guess about which word is
! more common, and one guess per initial is as good as a rule gets: after H-
! the th- word (SKPHA "and that", not "and hah"), elsewhere the word as struck
! (SKPAD "and add", not "and tad"). Over the 635 strokes the mined and-fold
! dictionary held, that writes the same word for 80% of their use. Last, a P-
! word shares its P with the chord: SKPHAEB is "and maybe".
define AndStroke  [ Stroke & [ S K P ?+ ] ] ;
define AndH       [ Stroke & [ S K P H ?* ] ] ;
define And(C, Add) Rule(C, [ "[FOLD]" {and} "[STRIP]" S K P Add "[END]" ]) ;
define PutT       [ "[ADD]" T ] ;
define PutP       [ "[ADD]" P ] ;

! A function word beside a word is two-word.json's rule read back: the
! word's stroke with `^`, the function word's consonants on the word's side,
! and the keys of its vowel's letter toggled. Where the word already holds the
! consonants they stay, which is the second alternative.
!
!   ^TPOU     ^ off, A on: TPAOU is "few"              a few
!   ^WOUFPB   ^ O -F off: WUPB is "one"                one of
!   ^THEUZ    ^ E U -Z off: TH is "this"               this is
!   ^OUPT     ^ O -T off: UP is "up"                   up to
!   ^SPHAOEB  ^ S- O off: PHAEB is "maybe"            so maybe
!
! Which words is measured. Most strokes have some base that translates, so
! each rule misreads strokes meant for the rules after it. a, of, is and to
! write 74% of the pairs the phrasing corpora hold five times or more. "to" or
! "the" before a word would lower that by six points each, so two-word.json
! keeps those pairs. "so" came later and is not in that measure.
define Caret      [ Stroke & $["^"] ] ;
define SoStroke   [ Caret & [ "^" S ?* ] ] ;

! "is" is S- on a word's stroke, unless S-K-P- says "and", and "it's" is ST-
! where T- and the rest is no word: STPHOU is "is now", STPWAD "it's bad". Of
! the corpora's "is" and "it's" bigrams whose stroke no entry holds, these
! read 93% of the use right before the suffixes and 77% after them. They go
! after anyway, so that a word's stroke and a suffix key is never misread:
! STAEUS is "stays", not "is it's a".
define Lead(C, Text, Keys) Rule([ [ Stroke & C ] - Caret ], [ "[FOLD]" Text "[STRIP]" Keys "[END]" ]) ;

! Toggle one key K, and take Off off too.
define Toggle(W, K, Off, Bf, Af)
    [ Rule([ W & $[K] ], [ "[FOLD]" Bf "[STRIP]" "^" K Off "[END]" Af ])
  .o. Rule([ W - $[K] ], [ "[FOLD]" Bf "[STRIP]" "^" Off "[ADD]" K "[END]" Af ]) ] ;

! Toggle E and U, the letter i.
define ToggleI(W, Off, Bf, Af)
    [ Rule([ W & $[E] & $[U] ], [ "[FOLD]" Bf "[STRIP]" "^" E U Off "[END]" Af ])
  .o. Rule([ [ W & $[E] ] - $[U] ], [ "[FOLD]" Bf "[STRIP]" "^" E Off "[ADD]" U "[END]" Af ])
  .o. Rule([ [ W & $[U] ] - $[E] ], [ "[FOLD]" Bf "[STRIP]" "^" U Off "[ADD]" E "[END]" Af ])
  .o. Rule([ W - $[E] - $[U] ], [ "[FOLD]" Bf "[STRIP]" "^" Off "[ADD]" E U "[END]" Af ]) ] ;

define After(K, C, Af)  [ Toggle([ Caret & $[C] ], K, C, 0, Af) .o. Toggle([ Caret & $[C] ], K, 0, 0, Af) ] ;
define AfterI(C, Af)    [ ToggleI([ Caret & $[C] ], C, 0, Af) .o. ToggleI([ Caret & $[C] ], 0, 0, Af) ] ;

! `#` is phrasing's, so no fold reads a stroke that holds it. A suffix comes
! before a word, so a two-syllable word's `^` stroke keeps its inflections.
define Folds [ [ Stroke - $["#"] ]
  .o. And(AndH, PutT)
  .o. And(AndStroke, 0)
  .o. And([ AndStroke - AndH ], PutT)
  .o. And(AndStroke, PutP)
  .o. Suffix(z, Infl({ofz}))
  .o. Suffix(d, Infl({ed}))
  .o. Suffix(s, Infl({ofs}))
  .o. Suffix(g, Infl({ing}))
  .o. Lead([ [ S ?+ ] - [ S K P ?* ] ], {is}, S)
  .o. Lead([ S T ?+ ], {it's}, S T)
  .o. Suffix(t, {the})
  .o. Suffix(f, {of})
  .o. Toggle(Caret, A, 0, {a}, 0)
  .o. Rule([ SoStroke & $[O] ], [ "[FOLD]" {so} "[STRIP]" "^" S O "[END]" ])
  .o. Rule([ SoStroke - $[O] ], [ "[FOLD]" {so} "[STRIP]" "^" S "[ADD]" O "[END]" ])
  .o. After(O, f, {of})
  .o. AfterI(z, {is})
  .o. After(O, t, {to})
  .o. [ [ Stroke .x. 0 ] Alts ] ] ;

define Grammar [ Bare | Folds ] ;
