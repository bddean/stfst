! Split. Index 0 breaks on word shape; the rest break on their
! own separator.
define SplitOp [
    [ Kill("U") Total(SplitShape) ] |
    [ Kill("U") Kill("l") Total(Split([ %[%=%-%] ])) ] |
    [ Kill("U") Kill("g") Total(Split([ %[%=%_%] ])) ] |
    [ Kill("U") Kill("l") Kill("g") Total(Split([ %[%=%:%] ])) ] |
    [ Kill("U") Kill("t") Total(Split([ %[%=%:%] %[%=%:%] ])) ] |
    [ Kill("U") Kill("l") Kill("t") Total(Split([ %[%=%/%] ])) ] |
    [ Kill("U") Kill("g") Kill("t") Total(Split([ %[%=%.%] ])) ] ] ;

! Wrap, and widen an existing wrap. `-R` takes the literal last
! word instead.
define WrapOp [
    [ Kill("E") Kill("U") Total(WrapFind(%[%=%(%], "(", %[%=%)%], ")")) ] |
    [ Kill("E") Kill("U") Kill("r") Total(Wrap("(", ")")) ] |
    [ Kill("E") Kill("U") Kill("l") Total(WrapFind(%[%=%[%], "[", %[%=%]%], "]")) ] |
    [ Kill("E") Kill("U") Kill("r") Kill("l") Total(Wrap("[", "]")) ] |
    [ Kill("E") Kill("U") Kill("g") Total(WrapFind(%[%=%{%], "{", %[%=%}%], "}")) ] |
    [ Kill("E") Kill("U") Kill("r") Kill("g") Total(Wrap("{", "}")) ] |
    [ Kill("E") Kill("U") Kill("l") Kill("g") Total(WrapFind(%[%=%<%], "<", %[%=%>%], ">")) ] |
    [ Kill("E") Kill("U") Kill("r") Kill("l") Kill("g") Total(Wrap("<", ">")) ] |
    [ Kill("E") Kill("U") Kill("t") Total(WrapFind(%[%=%"%], %", %[%=%"%], %")) ] |
    [ Kill("E") Kill("U") Kill("r") Kill("t") Total(Wrap(%", %")) ] |
    [ Kill("E") Kill("U") Kill("l") Kill("t") Total(WrapFind(%[%=%'%], "'", %[%=%'%], "'")) ] |
    [ Kill("E") Kill("U") Kill("r") Kill("l") Kill("t") Total(Wrap("'", "'")) ] |
    [ Kill("E") Kill("U") Kill("g") Kill("t") Total(WrapFind(%[%=%`%], "`", %[%=%`%], "`")) ] |
    [ Kill("E") Kill("U") Kill("r") Kill("g") Kill("t") Total(Wrap("`", "`")) ] |
    [ Kill("E") Kill("U") Kill("l") Kill("g") Kill("t") Total(WrapFind(%[%=%*%], "*", %[%=%*%], "*")) ] |
    [ Kill("E") Kill("U") Kill("r") Kill("l") Kill("g") Kill("t") Total(Wrap("*", "*")) ] ] ;

! `^A` opens the namespace and the four verbs partition the rest.
define Grammar Canon([ Kill("^") Kill(A) [ CaseOp | JoinOp | SplitOp | WrapOp ] ]) ;
