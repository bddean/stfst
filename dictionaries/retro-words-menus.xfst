! One row per stroke the layout reaches. Each row consumes its keys and
! names one rule, so the table is the entry set and not a rule set.
! The case dial on its own.
define CaseOp [
    [ Kill("f") Kill("r") Kill("p") Total(Last(UpAll)) ] |
    [ Kill("f") Kill("r") Kill("b") Total(Last(DownAll)) ] |
    [ Kill("f") Kill("p") Total(Find(UpAll)) ] |
    [ Kill("f") Kill("b") Total(Find(DownAll)) ] |
    [ Kill("r") Kill("p") Total(Last(UpFirst)) ] |
    [ Kill("r") Kill("b") Total(Last(DownFirst)) ] |
    [ Kill("p") Total(Find(UpFirst)) ] |
    [ Kill("b") Total(Find(DownFirst)) ] ] ;

! Join, with the dial composed in front of it where the dial keys
