define Alphabet [ [ KeysB .x. b ] | [ KeysC .x. c ] | [ KeysD .x. d ] | [ KeysF .x. f ]
                | [ KeysG .x. g ] | [ KeysH .x. h ] | [ KeysJ .x. j ] | [ KeysK .x. k ]
                | [ KeysL .x. l ] | [ KeysM .x. m ] | [ KeysN .x. n ] | [ KeysP .x. p ]
                | [ KeysQ .x. q ] | [ KeysR .x. r ] | [ KeysS .x. s ] | [ KeysT .x. t ]
                | [ KeysV .x. v ] | [ KeysW .x. w ] | [ KeysX .x. x ] | [ KeysY .x. y ]
                | [ KeysZ .x. z ] ] ;
