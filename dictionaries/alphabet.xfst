define KeysC {KR} ;
define KeysD {TK} ;
define KeysF {TP} ;
define KeysG {TKPW} ;
define KeysH {H} ;
define KeysJ {KWH} ;
define KeysK {K} ;
define KeysL {HR} ;
define KeysM {PH} ;
define KeysN {TPH} ;
define KeysP {P} ;
