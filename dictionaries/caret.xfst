! The marks contract.xfst puts before a syllable, applied to its stroke.
!
! `^` and keys: the stroke takes `^`, and its chord XOR the keys, a key both
! have not pressed. A stroke left with no key, or only the star, is not
! written.
!
!     ^E PROrt   ->  ^PROErt     report
!     ^EU HAp    ->  ^HAEUp      happy
!     ^ PHO*rt   ->  ^PHO*rt     mother
!
! A cluster: the prefix's keys, on the left bank beside the stroke's own, with
! `^` after it as above when the rest had two vowels.
!
!     STK PHRAEU  ->  STKPHRAEU  display
!
! `-`: nothing.

define Flip(X)  [ X:0 | 0:X ] ;
define FlipA    [ LeftKey* Flip(A) (O) ("*") (E) (U) RightKey* ] ;
define FlipO    [ LeftKey* (A) Flip(O) ("*") (E) (U) RightKey* ] ;
define FlipE    [ LeftKey* (A) (O) ("*") Flip(E) (U) RightKey* ] ;
define FlipU    [ LeftKey* (A) (O) ("*") (E) Flip(U) RightKey* ] ;

! The mark's first key off it, and flipped in the stroke.
define Xor(K, F) [ [ "^" Del(K) [ ? - Gap ]* Gap F ] | [ "^" [ [ ? - Gap ]* - [ K ?* ] ] Gap ?* ] ] ;
define Caret    [ [ Xor(A, FlipA) .o. Xor(O, FlipO) .o. Xor(E, FlipE) .o. Xor(U, FlipU) ]
                  .o. [ "^" Del(Gap) [ ?+ - "*" ] ] ] ;
define Cluster  [ [ LeftKey+ Del(Gap) LeftKey* ] .o. LeftBank ] VowelKeys RightKey* ;
define Clustered [ [ LeftKey+ Caret ] .o. [ Ins("^") [ [ LeftKey+ Del("^") LeftKey* ] .o. LeftBank ] VowelKeys RightKey* ] ] ;

define Stage    [ Rank Gap [ Caret | Cluster | Clustered | Del("-" Gap) ?* ] ] ;
