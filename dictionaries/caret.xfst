! The marks contract.xfst puts before a syllable, applied to its stroke.
!
! `^` and the other vowel's first letter: the stroke takes the letter's mark,
! whose keys are OR'd into it, so the stressed chord's keys all stay.
!
!     letter          a    e or none    i or y    o     u
!     mark            +    ^            ^+        +O    +U
!
!     ^E PROrt   ->  ^PROrt     report
!     ^EU HAp    ->  ^+HAp      happy
!     ^O TKAEU   ->  +TKAOEU    today
!     ^ PHO*rt   ->  ^PHO*rt    mother
!
! A cluster: the prefix's keys, on the left bank beside the stroke's own, with
! the mark before it as above when the rest had two vowels.
!
!     STK PHRAEU  ->  STKPHRAEU  display
!
! `-`: nothing.

define Keys     [ LeftKey* VowelKeys RightKey* ] ;
define OrO      [ LeftKey* (A) [ O | Ins(O) ] ("*") (E) (U) RightKey* ] ;
define OrU      [ LeftKey* (A) (O) ("*") (E) [ U | Ins(U) ] RightKey* ] ;

define Mark(L, M, Keyed) [ Del("^" L Gap) Ins(M) Keyed ] ;
define Caret    [ Mark(A, "+", Keys) | Mark(E, "^", Keys) | Mark({EU}, [ "^" "+" ], Keys)
                | Mark(O, "+", OrO) | Mark(U, "+", OrU) | Mark(0, "^", Keys) ] ;

! The mark to the front, before the prefix's keys.
define Front(M) [ Ins(M) LeftKey+ Del(M) ?* ] ;
define Cluster  [ [ LeftKey+ Del(Gap) LeftKey* ] .o. LeftBank ] VowelKeys RightKey* ;
define Clustered [ [ LeftKey+ Caret ] .o. [ Front("^") | Front("+") | Front([ "^" "+" ]) ]
                   .o. [ ("^") ("+") [ LeftKey+ .o. LeftBank ] VowelKeys RightKey* ] ] ;

define Stage    [ Rank Gap [ Caret | Cluster | Clustered | Del("-" Gap) ?* ] ] ;
