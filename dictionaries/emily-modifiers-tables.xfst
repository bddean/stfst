! The tables of the `@` namespace. The rules that read them are in
! emily-modifiers.xfst.

! A keysym name, per chord and variant.
define SymName [
    [ [ "T" "R" "[V=0]" ] .x. [ {Tab} ] ] |
    [ [ "T" "R" "[V=1]" ] .x. [ {Delete} ] ] |
