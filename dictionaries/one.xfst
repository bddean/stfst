! A syllable written as it is, for a stroke with no mark: `-`. After
! contract.xfst, whose pieces it shares, and with its words, so a stage of one
! syllable or two is one stage.
!
!     serve    S=s ER1=e V=rv_e  ->  - S=s ER1=e V=rv_e
!     cute     K.Y=c UW1=u T=t_e  ->  - K=c UW1=u T=t_e
!
! The glide is the vowel's, as in contract.xfst's stressed second syllable,
! and z spelled s is S.

define One(C)   [ Rank Gap Ins("-" Gap) Bare(C) Eq Letter* Syllable ] ;
define Single   [ Entry .o. [ [ ~$[z] .o. One(NoZ) ] | [ $[z] .o. One(Cons) ] ] .o. Glide .o. Dots ] ;

define Stage    [ Single | Contract ] ;
