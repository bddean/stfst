! 0 typey-type priority 30
! 1 repeat-word priority 7
!buffer	""
KAT	1	typey-type	cat	"cat"
^SKP	1	repeat-word	and [COPY1]	"cat and cat"
!buffer	""
HAOER	1	typey-type	here	"here"
^OR	1	repeat-word	or [COPY1]	"here or here"
!buffer	""
KAT	1	typey-type	cat	"cat"
^-T	1	repeat-word	the [COPY1]	"cat the cat"
!buffer	""
KAT	1	typey-type	cat	"cat"
^*F	1	repeat-word	of [COPY1]	"cat of cat"
!buffer	""
KAT	1	typey-type	cat	"cat"
^SKP	1	repeat-word	and [COPY1]	"cat and cat"
^SKP	1	repeat-word	and [COPY1]	"cat and cat and cat"
!buffer	""
-FT	1	typey-type	of the	"of the"
^SKP	1	repeat-word	and [COPY1]	"of the and the"
!buffer	""
KAT	1	typey-type	cat	"cat"
^SKP	1	repeat-word	and [COPY1]	"cat and cat"
!undo	^SKP	"cat"
^OR	1	repeat-word	or [COPY1]	"cat or cat"
! 15 strokes, 1 candidates at the widest
